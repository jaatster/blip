{
  "name": "@jaatster/blip-icons",
  "version": "0.1.0",
  "description": "Blip icons: original one-colour icons drawn on a 12 x 12 pixel grid, as SVG files, a sprite, JS path data and a <pp-icon> element.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "icons",
    "svg",
    "pixel-icons"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/icons#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "github:blip/blip",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./svg/*": "./dist/svg/*",
    "./icons.json": "./dist/icons.json",
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "custom-elements.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
