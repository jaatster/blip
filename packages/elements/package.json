{
  "name": "@jaatster/blip-elements",
  "version": "0.1.2",
  "description": "Blip Web Components: light-DOM custom elements that add behaviour to the components' markup.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "web-components",
    "custom-elements",
    "accessibility"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/elements#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaatster/blip.git",
    "directory": "packages/elements"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "docs",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-ts-package.mjs elements"
  },
  "dependencies": {
    "@jaatster/blip-core": "workspace:*",
    "@jaatster/blip-tokens": "workspace:*"
  }
}
