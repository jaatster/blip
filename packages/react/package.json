{
  "name": "@jaatster/blip-react",
  "version": "0.2.0",
  "description": "Typed React components for Blip: every core component and kit, rendering the system's own markup and Web Components.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "react",
    "components",
    "web-components"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/react#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaatster/blip.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./game": {
      "types": "./dist/game.d.ts",
      "default": "./dist/game.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "default": "./dist/blocks.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "default": "./dist/effects.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.examples.json && tsc -p tsconfig.examples.react18.json",
    "test": "node --test --test-force-exit \"test/*.test.mjs\" && node --import ./test/react-18.mjs --test --test-force-exit \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "react": ">=18.3.0"
  },
  "dependencies": {
    "@jaatster/blip-effects": "workspace:^",
    "@jaatster/blip-elements": "workspace:^",
    "@jaatster/blip-game": "workspace:^",
    "@jaatster/blip-icons": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-18": "npm:@types/react@18.3.31",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-18": "npm:react@18.3.1",
    "react-dom": "^19.3.1",
    "react-dom-18": "npm:react-dom@18.3.1"
  }
}
