{
  "name": "@jaatster/blip-effects",
  "version": "0.1.1",
  "description": "Blip effects: dithered world backdrops, transitions, text effects, bursts, CRT filter, time of day. All opt-in, all honour reduced motion.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "effects",
    "dither",
    "transitions",
    "canvas",
    "view-transitions"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/effects#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaatster/blip.git",
    "directory": "packages/effects"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effects.css": "./dist/effects.css",
    "./*.css": "./dist/*.css",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "custom-elements.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-css-package.mjs effects && node ../../scripts/build-ts-package.mjs effects"
  },
  "dependencies": {
    "@jaatster/blip-core": "workspace:*",
    "@jaatster/blip-tokens": "workspace:*"
  }
}
