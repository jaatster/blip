{
  "name": "@blip/game",
  "version": "0.1.0",
  "description": "The Blip game UI kit: dialogue boxes, HUD bars, inventories, button prompts, pause menus.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "game-ui",
    "hud",
    "rpg",
    "web-components"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/game#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "github:jaatster/blip",
    "directory": "packages/game"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./game.css": "./dist/game.css",
    "./*.css": "./dist/*.css",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "custom-elements.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-css-package.mjs game && node ../../scripts/build-ts-package.mjs game"
  },
  "dependencies": {
    "@blip/core": "workspace:*",
    "@blip/tokens": "workspace:*",
    "@blip/components": "workspace:*"
  }
}
