# Spacing forms of the marks, at the top of the capitals (or hanging below the baseline).
@ ` = grave(0,-3)
@ ´ = acute(0,-3)
@ ¨ = dieresis(0,-3)
@ ¯ = macron(0,-2)
@ ¸ = cedilla(0,0)
@ U+02C6 = circumflex(0,-3)
@ U+02C7 = caron(0,-3)
@ U+02D8 = breve(0,-3)
@ U+02D9 = dotaccent(0,-3)
@ U+02DA = ring(0,-4)
@ U+02DB = ogonek(0,0)
@ U+02DC = tilde(0,-3)
@ U+02DD = hungarumlaut(0,-3)

