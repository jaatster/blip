@ U+030A mark=above base=6
.X.
X.X
.X.

@ U+030B mark=above lean=right base=6
.X..X
X..X.

@ U+030C mark=above base=6
X.X
.X.

# The caron of ď, ľ, ť and Ľ: a closing quote beside the stem.
@ uni030C.alt mark=beside base=5
XX
.X

# The Latvian ģ: a turned comma above.
@ U+0312 mark=above base=6
X.
XX

# Comma below (Romanian ș, ț; Latvian ķ, ļ, ņ, ŗ): a comma, one empty row under the letter.
@ U+0326 mark=below base=-3
XX
.X

# Cedilla: hangs from the letter and curls right. Ogonek: hangs from the last column and curls left.
@ U+0327 mark=below lean=right base=-2
X.
.X

@ U+0328 mark=ogonek base=-2
.X
X.

# Spacing accents: the marks on their own.
@ ´ = U+0301(0,0)
@ U+02DD = U+030B(0,0)
@ U+02D8 = U+0306(0,0)
@ U+02DA = U+030A(0,0)
@ ¸ = U+0327(0,0)
@ U+02DB = U+0328(0,0)

@ ĭ = U+0131 U+0306

# The hyphens and dashes the font leaves out: the soft hyphen, the hyphen, the non-breaking hyphen (as -), the figure
# dash (as the en dash) and the horizontal bar (as the em dash).
@ U+00AD = -
@ U+2010 = -
@ U+2011 = -
@ U+2012 = U+2013
@ U+2015 = U+2014

