{
  "name": "@jaatster/blip-font",
  "version": "0.2.0",
  "description": "Pixel Bop, Blip's pixel display font, and Pixelify Sans for UI text, each in Latin, Cyrillic and Greek. SIL OFL 1.1.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "font",
    "pixel-font",
    "woff2",
    "ofl"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/font#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaatster/blip.git",
    "directory": "packages/font"
  },
  "license": "OFL-1.1",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./font.css": "./font.css",
    "./pixel-bop.woff2": "./dist/pixel-bop.woff2",
    "./pixel-bop-cyrillic.woff2": "./dist/pixel-bop-cyrillic.woff2",
    "./pixel-bop-greek.woff2": "./dist/pixel-bop-greek.woff2",
    "./pixel-bop.ttf": "./dist/pixel-bop.ttf",
    "./pixelify-sans.woff2": "./dist/pixelify-sans.woff2",
    "./pixelify-sans-cyrillic.woff2": "./dist/pixelify-sans-cyrillic.woff2",
    "./pixelify-sans-greek.woff2": "./dist/pixelify-sans-greek.woff2",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "font.css",
    "OFL.txt",
    "OFL-PixelifySans.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "../../.tools/venv/bin/python -I scripts/build.py"
  }
}
