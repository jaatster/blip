    },
    "focus": {
      "$type": "number",
      "$value": 1,
      "$description": "Each of the two lines of the focus ring: yellow inside, ink outside.",
      "$extensions": {
        "blip": {
          "unit": "pixel"
        }
      }
    },
    "drop": {
      "$type": "number",
      "$value": 1,
      "$description": "The drop shadow down and to the right.",
      "$extensions": {
        "blip": {
          "unit": "pixel"
        }
      }
    }
  },
  "target": {
    "min": {
      "$type": "number",
      "$value": 12,
      "$description": "The smallest click or touch target: 24 CSS px (WCAG 2.2, 2.5.8).",
      "$extensions": {
        "blip": {
          "unit": "pixel"
        }
      }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Layout breakpoints in CSS px. Prefer container queries; these are for page shells.",
    "medium": {
      "$value": {
        "value": 600,
        "unit": "px"
      }
    },
    "wide": {
      "$value": {
        "value": 1024,
