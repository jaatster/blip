{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Night: deep indigo under the stars. Purple is the accent.",
  "$extensions": {
    "blip": {
      "scheme": "night",
      "colorScheme": "dark"
    }
  },
  "$type": "color",
  "bg": {
    "$value": "{deep.3}",
    "$description": "The page behind everything."
  },
  "surface": {
    "base": {
      "$value": "{deep.4}",
      "$description": "Cards, inputs, panels."
    },
    "raised": {
      "$value": "{deep.5}",
      "$description": "Things above the page: menus, dialogs, windows."
    },
    "sunken": {
      "$value": "{deep.2}",
      "$description": "Wells, tracks, table stripes."
    },
    "panel": {
      "$value": "{deep.4}",
      "$description": "Text-heavy panels (cream on the light schemes)."
    }
  },
  "text": {
    "base": {
      "$value": "{tone.star}",
      "$description": "Body text."
    },
    "muted": {
      "$value": "{world.night.snow.lit}",
      "$description": "Secondary text."
    },
    "inverse": {
      "$value": "{ink.base}",
      "$description": "Text on an inverted surface."
    }
  },
  "line": {
    "base": {
      "$value": "{world.night.cloud.light}",
      "$description": "Outlines of non-candy controls; 3:1 against the page."
    },
    "soft": {
      "$value": "{world.night.sky.2}",
      "$description": "Dividers and decoration only."
    }
  },
  "outline": {
    "$value": "{ink.base}",
    "$description": "The outline of every candy box, in every scheme. Ink, never black."
  },
  "drop": {
    "$value": "{ink.base}",
    "$description": "The one-pixel drop shadow down and to the right."
  },
  "focus": {
    "base": {
      "$value": "{candy.yellow.base}",
      "$description": "The focus ring: always yellow."
    },
    "edge": {
      "$value": "{ink.base}",
      "$description": "The ink line outside the yellow, so focus reads on light and dark."
    }
  },
  "accent": {
    "base": {
      "$value": "{candy.purple.base}"
    },
    "light": {
      "$value": "{candy.purple.light}"
    },
    "shade": {
      "$value": "{candy.purple.shade}"
    },
    "text": {
      "$value": "{tone.accent-night}",
      "$description": "This intent as text on the scheme's surfaces (AA)."
    },
    "on": {
      "$value": "{ink.base}",
      "$description": "Labels and icons on this intent's candy (AA)."
    }
  },
  "info": {
    "base": {
      "$value": "{candy.blue.base}"
    },
    "light": {
      "$value": "{candy.blue.light}"
    },
    "shade": {
      "$value": "{candy.blue.shade}"
    },
    "text": {
      "$value": "{candy.blue.light}",
      "$description": "This intent as text on the scheme's surfaces (AA)."
    },
    "on": {
      "$value": "{ink.base}",
      "$description": "Labels and icons on this intent's candy (AA)."
    }
  },
  "success": {
    "base": {
      "$value": "{candy.green.base}"
    },
    "light": {
      "$value": "{candy.green.light}"
    },
    "shade": {
      "$value": "{candy.green.shade}"
    },
    "text": {
      "$value": "{candy.green.light}",
      "$description": "This intent as text on the scheme's surfaces (AA)."
    },
    "on": {
      "$value": "{ink.base}",
      "$description": "Labels and icons on this intent's candy (AA)."
    }
  },
  "warning": {
    "base": {
      "$value": "{candy.orange.base}"
    },
    "light": {
      "$value": "{candy.orange.light}"
    },
    "shade": {
      "$value": "{candy.orange.shade}"
    },
    "text": {
      "$value": "{candy.orange.light}",
      "$description": "This intent as text on the scheme's surfaces (AA)."
    },
    "on": {
      "$value": "{ink.base}",
      "$description": "Labels and icons on this intent's candy (AA)."
    }
  },
  "danger": {
    "base": {
      "$value": "{candy.red.base}"
    },
    "light": {
      "$value": "{candy.red.light}"
    },
    "shade": {
      "$value": "{candy.red.shade}"
    },
    "text": {
      "$value": "{tone.danger-night}",
      "$description": "This intent as text on the scheme's surfaces (AA)."
    },
    "on": {
      "$value": "{ink.base}",
      "$description": "Labels and icons on this intent's candy (AA)."
    }
  },
  "selection": {
    "bg": {
      "$value": "{candy.purple.light}",
      "$description": "Selected text background."
    },
    "text": {
      "$value": "{ink.base}"
    }
  },
  "scrim": {
    "$value": "{ink.base}",
    "$description": "Behind dialogs: drawn as a dither, never a translucent wash."
  },
  "link": {
    "visited": {
      "$value": "{candy.pink.light}",
      "$description": "Visited links (AA on the scheme's surfaces)."
    }
  },
  "disabled": {
    "dither": {
      "$value": "{tone.star}",
      "$description": "The checkerboard over a disabled candy: light in every scheme, so its label still reads (the page colour by Day and Sunset, Starlight at Night)."
    },
    "dither-cream": {
      "$value": "{world.night.snow.lit}",
      "$description": "The checkerboard over disabled cream (the neutral tone, cream tabs, the switch knob), where the page colour would not show."
    }
  },
  "scene": {
    "$description": "The world's colours for this time of day, for scenes drawn in CSS (game stages, hero strips).",
    "sky": {
      "1": {
        "$value": "{world.night.sky.1}"
      },
      "2": {
        "$value": "{world.night.sky.2}"
      },
      "3": {
        "$value": "{world.night.sky.3}"
      },
      "4": {
        "$value": "{world.night.sky.4}"
      },
      "5": {
        "$value": "{world.night.sky.5}"
      },
      "6": {
        "$value": "{world.night.sky.6}"
      }
    },
    "cloud": {
      "light": {
        "$value": "{world.night.cloud.light}"
      },
      "body": {
        "$value": "{world.night.cloud.body}"
      },
      "shade": {
        "$value": "{world.night.cloud.shade}"
      }
    },
    "mountain": {
      "lit": {
        "$value": "{world.night.mountain.lit}"
      },
      "shadow": {
        "$value": "{world.night.mountain.shadow}"
      },
      "edge": {
        "$value": "{world.night.mountain.edge}"
      }
    },
    "hill": {
      "mid": {
        "$value": "{world.night.hill.mid}"
      },
      "near": {
        "$value": "{world.night.hill.near}"
      },
      "bush": {
        "$value": "{world.night.hill.bush}"
      }
    },
    "grass": {
      "base": {
        "$value": "{world.night.grass.base}"
      },
      "top": {
        "$value": "{world.night.grass.top}"
      },
      "lip": {
        "$value": "{world.night.grass.lip}"
      }
    },
    "dirt": {
      "base": {
        "$value": "{world.night.dirt.base}"
      },
      "shadow": {
        "$value": "{world.night.dirt.shadow}"
      },
      "pebble": {
        "$value": "{world.night.dirt.pebble}"
      }
    }
  }
}
