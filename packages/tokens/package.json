{
  "name": "@jaatster/blip-tokens",
  "version": "0.1.0",
  "description": "Blip design tokens in the W3C DTCG 2025.10 format, with CSS, JS/TS, Android, iOS and Figma exports.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "design-tokens",
    "dtcg",
    "css-variables",
    "figma"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "github:blip/blip",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "blip-tokens": "scripts/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./palettes.css": "./dist/css/palettes.css",
    "./tokens.json": "./dist/json/tokens.json",
    "./manifest.json": "./dist/json/manifest.json",
    "./figma/variables.json": "./dist/figma/variables.json",
    "./resolver": "./blip.resolver.json",
    "./contrast.json": "./contrast.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "blip.resolver.json",
    "contrast.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "palettes": "node scripts/palettes.mjs"
  }
}
