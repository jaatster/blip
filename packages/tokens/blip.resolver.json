{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Blip",
  "version": "2025.10",
  "description": "Blip's tokens. Three independent switches: scheme (time of day), pixel size and palette; later, contrast. Adding a context is adding a file.",
  "sets": {
    "foundation": {
      "description": "Colour, size, motion and type primitives.",
      "sources": [
        {
          "$ref": "src/primitives/color.tokens.json"
        },
        {
          "$ref": "src/primitives/size.tokens.json"
        },
        {
          "$ref": "src/primitives/motion.tokens.json"
        },
        {
          "$ref": "src/primitives/type.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "scheme": {
      "description": "The time of day. Auto picks one by the clock at runtime.",
      "contexts": {
        "day": [
          {
            "$ref": "src/schemes/day.tokens.json"
          }
        ],
        "sunset": [
          {
            "$ref": "src/schemes/sunset.tokens.json"
          }
        ],
        "night": [
          {
            "$ref": "src/schemes/night.tokens.json"
          }
        ]
      },
      "default": "day"
    },
    "pixel": {
      "description": "The size of one pixel in CSS px.",
      "contexts": {
        "2": [
          {
            "$ref": "src/pixel/2.tokens.json"
          }
        ],
        "3": [
          {
            "$ref": "src/pixel/3.tokens.json"
          }
        ],
        "4": [
          {
            "$ref": "src/pixel/4.tokens.json"
          }
        ]
      },
      "default": "2"
    },
    "palette": {
      "description": "The accent of each time of day and Night's page, ink and sky. Candy is Blip's own; the rest are presets (palettes.css, data-blip-palette). A preset lists Candy first, so it sets only what it changes.",
      "contexts": {
        "candy": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          }
        ],
        "grape": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/grape.tokens.json"
          }
        ],
        "ember": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/ember.tokens.json"
          }
        ],
        "azure": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/azure.tokens.json"
          }
        ],
        "mint": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/mint.tokens.json"
          }
        ],
        "bubblegum": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/bubblegum.tokens.json"
          }
        ],
        "dracula": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/dracula.tokens.json"
          }
        ],
        "nord": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/nord.tokens.json"
          }
        ],
        "catppuccin": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/catppuccin.tokens.json"
          }
        ],
        "gruvbox": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/gruvbox.tokens.json"
          }
        ],
        "tokyo-night": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/tokyo-night.tokens.json"
          }
        ],
        "rose-pine": [
          {
            "$ref": "src/palettes/candy.tokens.json"
          },
          {
            "$ref": "src/palettes/rose-pine.tokens.json"
          }
        ]
      },
      "default": "candy"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/foundation"
    },
    {
      "$ref": "#/modifiers/pixel"
    },
    {
      "$ref": "#/modifiers/palette"
    },
    {
      "$ref": "#/modifiers/scheme"
    }
  ]
}
