{
  "name": "@jaatster/blip-blocks",
  "version": "0.1.3",
  "description": "Blip website blocks: hero, feature grid, pricing, CTA band, footer.",
  "keywords": [
    "blip",
    "pixel-art",
    "design-system",
    "landing-page",
    "website",
    "blocks",
    "css"
  ],
  "homepage": "https://github.com/jaatster/blip/tree/main/packages/blocks#readme",
  "bugs": "https://github.com/jaatster/blip/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaatster/blip.git",
    "directory": "packages/blocks"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blocks.css": "./dist/blocks.css",
    "./*.css": "./dist/*.css",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-css-package.mjs blocks && node ../../scripts/build-ts-package.mjs blocks"
  },
  "dependencies": {
    "@jaatster/blip-core": "workspace:*",
    "@jaatster/blip-tokens": "workspace:*",
    "@jaatster/blip-components": "workspace:*"
  }
}
