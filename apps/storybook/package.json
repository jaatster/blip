{
  "name": "@blip/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blip's Storybook: every example, its states, docs from the component markdown, interaction and accessibility tests.",
  "license": "MIT",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && storybook dev -p 6006",
    "build": "node scripts/generate.mjs && storybook build -o storybook-static",
    "test": "node scripts/generate.mjs && vitest run"
  },
  "devDependencies": {
    "@blip/blocks": "workspace:*",
    "@blip/components": "workspace:*",
    "@blip/core": "workspace:*",
    "@blip/effects": "workspace:*",
    "@blip/elements": "workspace:*",
    "@blip/font": "workspace:*",
    "@blip/game": "workspace:*",
    "@blip/icons": "workspace:*",
    "@blip/sound": "workspace:*",
    "@blip/tokens": "workspace:*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "parse5": "^8.0.1",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
