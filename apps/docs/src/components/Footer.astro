---
/** The site's foot: what Blip is made of, its licences, and the way back. */
import { pkgVersion } from "../lib/data";
const version = pkgVersion("components");
---
<footer class="docs-footer">
  <div class="docs-footer-inner">
    <p class="docs-footer-brand"><span class="pp-display" data-scale="1">Blip</span> <span class="pp-muted">{version}</span></p>
    <p class="pp-small pp-muted">This site is built with Blip itself: its tokens, CSS, elements, fonts, icons and world. No images, no framework.</p>
    <p class="pp-small pp-muted">Code and icons: MIT. Pixel Bop and Pixelify Sans: SIL Open Font License 1.1.</p>
    <ul class="docs-footer-links" role="list">
      <li><a href="/start/">Get started</a></li>
      <li><a href="/versions/">Versions and support</a></li>
      <li><a href="/foundations/accessibility/">Accessibility</a></li>
      <li><a href="/diagnostics/">Diagnostics</a></li>
      <li><a href="/search/">All pages</a></li>
    </ul>
  </div>
</footer>
