---
/**
 * The section's own navigation, down the side. On a wide screen it is part of the page; on a narrower one the same
 * list opens from a button as a popover (a drawer from the start edge), so there is never a second copy of it.
 */
import Icon from "./Icon.astro";
import type { Section } from "../lib/nav";
interface Props {
  section: Section;
}
const { section } = Astro.props;
const path = Astro.url.pathname;
const groups = section.groups();
---
<nav class="blip-sidebar docs-sidebar" id="docs-nav" popover aria-label={section.title} data-arrow data-section={section.id}>
  <div class="docs-sidebar-head">
    <p class="docs-sidebar-title">{section.title}</p>
    <button class="blip-box blip-button docs-sidebar-close" type="button" data-variant="ghost" data-size="sm" data-icon-only popovertarget="docs-nav" popovertargetaction="hide" aria-label="Close the list"><Icon name="close" /></button>
  </div>
  {groups.map((g, i) => (
    <Fragment>
      {g.title && <h2 class="blip-sidebar-heading" id={`docs-nav-${i}`}>{g.title}</h2>}
      <ul class="blip-sidebar-list" role="list" aria-labelledby={g.title ? `docs-nav-${i}` : undefined}>
        {g.items.map((item) => (
          <li>
            <a class="blip-box blip-sidebar-item" data-variant="ghost" href={item.url} aria-current={item.url === path ? "page" : undefined}>
              {item.icon && <Icon name={item.icon} />}
              <span class="blip-sidebar-label">{item.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </Fragment>
  ))}
</nav>
<script is:inline>
  // Before the first paint, so moving between pages never jumps the list: it stays where the reader left it in this
  // section, unless that would hide where they are now; arriving from elsewhere, where they are shows a third of the
  // way down. Its place is kept for the next page as it scrolls.
  (() => {
    const nav = document.getElementById("docs-nav"), here = nav.querySelector('[aria-current="page"]'), key = "blip-docs:nav";
    if (!here || nav.scrollHeight <= nav.clientHeight) return;
    let kept = null;
    try { kept = JSON.parse(sessionStorage.getItem(key)); } catch (e) {}
    const shows = (top) => here.offsetTop >= top && here.offsetTop + here.offsetHeight <= top + nav.clientHeight;
    nav.scrollTop = kept && kept.section === nav.dataset.section && shows(kept.top) ? kept.top : Math.max(0, here.offsetTop - nav.clientHeight / 3);
    const keep = () => { try { sessionStorage.setItem(key, JSON.stringify({ section: nav.dataset.section, top: nav.scrollTop })); } catch (e) {} };
    keep();
    nav.addEventListener("scroll", keep, { passive: true });
  })();
  // Open as the drawer (under 1024 px), the list is modal: the page behind it is inert, so Tab stays in the list and
  // the page can't scroll (docs.css). Escape, Close and a tap on the scrim close it as before. Focus starts on the
  // page you are on and goes back to the button that opened the list.
  (() => {
    const nav = document.getElementById("docs-nav"), toggle = document.querySelector(".docs-nav-toggle");
    const behind = () => document.querySelectorAll(".docs-shell > :not(#docs-nav), body > .blip-skip-link");
    nav.addEventListener("beforetoggle", (e) => {
      // Before it hides, so the browser can hand focus back to the button.
      if (e.newState === "closed") for (const el of behind()) el.inert = false;
    });
    nav.addEventListener("toggle", (e) => {
      if (e.newState === "open") {
        for (const el of behind()) el.inert = true;
        (nav.querySelector('[aria-current="page"]') || nav.querySelector(".docs-sidebar-close"))?.focus();
      } else if (toggle && (!document.activeElement || document.activeElement === document.body || nav.contains(document.activeElement))) {
        toggle.focus();
      }
    });
    // Wide enough for the list to be part of the page again: the drawer closes.
    matchMedia("(min-width: 1024px)").addEventListener("change", (m) => { if (m.matches && nav.matches(":popover-open")) nav.hidePopover(); });
  })();
</script>
