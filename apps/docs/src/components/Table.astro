---
/**
 * A reference table in the system's table component. Cells are HTML (escape text with esc()). On a phone its rows
 * stack (data-stack): the first cell leads, the others are labelled with their column's header (data-label).
 */
import { stripTags } from "../lib/html";
interface Props {
  label: string;
  head: string[];
  rows: string[][];
  caption?: string;
  numeric?: number[];
  class?: string;
}
const { label, head, rows, caption, numeric = [], class: cls } = Astro.props;
---
<div class:list={["pp-box pp-table-frame docs-table-frame", cls]}>
  <div class="pp-table-scroll docs-table-scroll" role="region" tabindex="0" aria-label={label}>
    <table class="pp-table docs-table" data-density="compact" data-stack>
      {caption && <caption>{caption}</caption>}
      <thead><tr>{head.map((h, i) => <th scope="col" class={numeric.includes(i) ? "pp-numeric" : undefined}>{h || <span class="pp-sr-only">Notes</span>}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => <tr>{r.map((c, i) => <td class={numeric.includes(i) ? "pp-numeric" : undefined} data-label={i > 0 && head[i] ? stripTags(head[i]) : undefined} set:html={c} />)}</tr>)}
      </tbody>
    </table>
  </div>
</div>
