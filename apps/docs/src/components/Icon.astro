---
/** A Blip icon as inline SVG, from @jaatster/blip-icons' data: decorative unless it has a label. */
import { iconPath } from "../lib/data";
interface Props {
  name: string;
  label?: string;
  size?: "lg";
  class?: string;
}
const { name, label, size, class: cls } = Astro.props;
---
<svg class:list={["blip-icon", cls]} viewBox="0 0 12 12" data-size={size} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}><path d={iconPath(name)} /></svg>
