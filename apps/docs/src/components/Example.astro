---
/**
 * A live example: the package's own fragment, rendered in the page as it is, on a stage whose scheme and pixel can be
 * switched on their own. Then its source, to copy: behind "Show the HTML" (with a copy button beside it), or shown
 * at once (sourceOpen, for a snippet).
 */
import { codeBlock } from "../lib/markdown";
interface Props {
  id: string;
  html: string;
  source: string;
  note?: string;
  title?: string;
  switches?: boolean;
  /** The title's heading level: 2 for the page's example, 3 for a snippet under "Snippets". */
  level?: 2 | 3;
  /** Show the source under the stage, not behind "Show the HTML". */
  sourceOpen?: boolean;
}
const { id, html, source, note, title = "Example", switches = true, level = 2, sourceOpen = false } = Astro.props;
const code = await codeBlock(source, "html", "HTML", !sourceOpen);
const Heading = level === 3 ? "h3" : "h2";
---
<section class="docs-example" data-level={level} aria-labelledby={id}>
  <div class="docs-example-bar">
    <div class="docs-stack" style="gap:var(--chu-space-2)">
      <Heading class="docs-example-title" id={id}>{title}</Heading>
      {note && <p class="docs-example-note">{note}</p>}
    </div>
    {switches && (
      <div class="docs-example-switches docs-needs-js">
        <chu-segmented class="chu-box chu-segmented" data-size="sm" aria-label="Scheme of the example" data-stage={`${id}-stage`} data-attr="scheme" value="page">
          <button class="chu-box" type="button" value="page" aria-checked="true">Page</button>
          <button class="chu-box" type="button" value="day">Day</button>
          <button class="chu-box" type="button" value="sunset">Sunset</button>
          <button class="chu-box" type="button" value="night">Night</button>
        </chu-segmented>
        <chu-segmented class="chu-box chu-segmented" data-size="sm" aria-label="Pixel size of the example" data-stage={`${id}-stage`} data-attr="pixel" value="2">
          <button class="chu-box" type="button" value="2" aria-checked="true">2 px</button>
          <button class="chu-box" type="button" value="3">3 px</button>
          <button class="chu-box" type="button" value="4">4 px</button>
        </chu-segmented>
      </div>
    )}
  </div>
  <div class="chu-box docs-stage" id={`${id}-stage`}><div class="docs-stage-scroll"><Fragment set:html={html} /></div></div>
  {sourceOpen
    ? <div class="docs-source-open"><Fragment set:html={code} /></div>
    : (
      <div class="docs-source-row">
        <details class="docs-source" id={`${id}-source`}>
          <summary class="chu-box chu-button" data-variant="outline" data-size="sm"><span class="docs-when-closed">Show the HTML</span><span class="docs-when-open">Hide the HTML</span></summary>
          <Fragment set:html={code} />
        </details>
        <button class="chu-box chu-button docs-copy docs-source-copy" type="button" data-variant="ghost" data-size="sm" data-copy-from={`#${id}-source pre`} hidden>Copy the HTML</button>
      </div>
    )}
</section>
