---
/**
 * The document every page shares: the import map, Blip's CSS in its order (font, tokens, palettes, core,
 * components, kits), the scheme, pixel and palette the reader chose (set before the first paint), and only the
 * element modules the page's own markup uses.
 */
import { assets, tokens } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  /** Kit stylesheets the page needs, after the components. */
  kits?: ("game" | "blocks" | "effects")[];
  /** Page stylesheets from /css, after the site's own. */
  styles?: string[];
  /** Page scripts from /js (modules). */
  scripts?: string[];
  /** Preload Pixel Bop (pages that open with big display text). */
  display?: boolean;
  bodyClass?: string;
}
const { title, description = "Blip: a 16-bit pixel-art design system. Candy on pastel, ink outlines, one pixel size, motion that snaps.", kits = [], styles = [], scripts = [], display = false, bodyClass } = Astro.props;
const a = assets();
const html = await Astro.slots.render("default");
// The elements this page's markup uses: load their modules, and nothing else.
const tags = new Set([...html.matchAll(/<(pp-[a-z0-9-]+)[\s>/]/g)].map((m) => m[1]!));
// Behaviour some markup asks for by attribute rather than by tag.
const byAttribute: [RegExp, string][] = [[/data-pp-burst=/, "/pp/effects/burst.js"]];
const modules = [...new Set([...[...tags].map((t) => a.defines[t]), ...byAttribute.filter(([re]) => re.test(html)).map(([, m]) => m)].filter((m): m is string => !!m))];
const pageTitle = title === "Blip" ? title : `${title} · Blip`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The presets a reader can pick (the default palette is having none).
const presets = Object.keys(tokens().palettes ?? {}).join(" ");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F7FF" />
    <script is:inline data-presets={presets}>
      // The scheme, pixel and palette the reader chose, before the first paint. ?scheme=, ?pixel= and ?palette= try
      // one without saving.
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search), pref = "auto", px = "", pal = "";
        var presets = (document.currentScript.getAttribute("data-presets") || "").split(" ");
        try { pref = localStorage.getItem("blip-docs:scheme") || "auto"; px = localStorage.getItem("blip-docs:pixel") || ""; pal = localStorage.getItem("blip-docs:palette") || ""; } catch (e) {}
        if (/^(auto|day|sunset|night)$/.test(q.get("scheme") || "")) pref = q.get("scheme");
        if (/^[234]$/.test(q.get("pixel") || "")) px = q.get("pixel");
        if (q.has("palette")) pal = q.get("palette");
        if (pal && presets.indexOf(pal) >= 0) d.setAttribute("data-pp-palette", pal);
        var h = new Date().getHours();
        d.setAttribute("data-pp-scheme", pref === "auto" ? (h >= 6 && h < 17 ? "day" : h >= 17 && h < 19 ? "sunset" : "night") : pref);
        d.setAttribute("data-scheme-choice", pref);
        if (px === "3" || px === "4") d.setAttribute("data-pp-pixel", px);
        d.classList.add("js");
      })();
    </script>
    <script type="importmap" set:html={JSON.stringify(a.importMap)} />
    <link rel="preload" href="/pp/font/dist/pixelify-sans.woff2" as="font" type="font/woff2" crossorigin />
    {display && <link rel="preload" href="/pp/font/dist/pixel-bop.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href="/pp/font/font.css" />
    <link rel="stylesheet" href="/pp/tokens/tokens.css" />
    <link rel="stylesheet" href="/pp/tokens/palettes.css" />
    <link rel="stylesheet" href="/pp/core/core.css" />
    <link rel="stylesheet" href="/pp/components/components.css" />
    <link rel="stylesheet" href="/pp/components/popover-nub.css" />
    {kits.map((k) => <link rel="stylesheet" href={`/pp/${k}/${k}.css`} />)}
    <link rel="stylesheet" href="/css/docs.css" />
    {styles.map((s) => <link rel="stylesheet" href={`/css/${s}.css`} />)}
    {modules.length > 0 && a.coreModules.map((m) => <link rel="modulepreload" href={m} />)}
    {modules.map((m) => <link rel="modulepreload" href={m} />)}
    <script type="module" src="/js/site.js"></script>
    {modules.length > 0 && <script type="module" set:html={modules.map((m) => `import "${m}";`).join("")} />}
    {scripts.map((s) => <script type="module" src={`/js/${s}.js`}></script>)}
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] })} />
  </head>
  <body class={bodyClass}>
    <Fragment set:html={html} />
  </body>
</html>
