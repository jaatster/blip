---
/** The foundations: what every component is made of. */
import Docs from "../../layouts/Docs.astro";
import Icon from "../../components/Icon.astro";
import Pager from "../../components/Pager.astro";
import { FOUNDATIONS } from "../../lib/nav";
---
<Docs styles={["foundations"]} scripts={["foundations"]} title="Foundations" description="Blip's foundations: colour, the pixel and space, type, shape, depth, motion, states, sound, icons and accessibility.">
  <header class="docs-page-head">
    <h1 class="docs-page-title chu-display" data-scale="2">Foundations</h1>
    <p class="docs-lede">The parts every component is made of. Each page here is generated from the tokens and the packages, so it always says what the code does.</p>
  </header>
  <ul class="docs-index-list docs-foundations" role="list">
    {FOUNDATIONS.map((f) => (
      <li>
        <a href={f.url}>
          <span class="docs-index-name"><Icon name={f.icon!} /> {f.title}</span>
          <span class="docs-index-text">{f.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
  <Pager />
</Docs>
