---
/** Shape: the candy box, taken apart; its corners, 0 to 8; its tiers; its tones. */
import Docs from "../../layouts/Docs.astro";
import Pager from "../../components/Pager.astro";
import { codeBlock } from "../../lib/markdown";

const parts = [
  ["Outline", "One ink pixel, round stepped corners. Drawn from the box's own shape, so it is crisp at any size."],
  ["Light band", "The top of the fill, in the tone's light: about 0.65 saturation, full brightness."],
  ["Base", "The tone itself, in the middle."],
  ["Shade band", "The bottom of the fill, in the tone's shade: about 0.84 brightness."],
  ["Glints", "Three white pixels at the top left, one at the top right."],
  ["Drop", "The outline's shape again, a pixel down and to the right. Hover lifts the box off it; pressing sits the box in it."],
];
const tiers = [
  ["candy", "Candy", "The main action. One per view."],
  ["soft", "Soft", "Secondary actions: the light fill, an ink outline."],
  ["outline", "Outline", "Dense UI: toolbars, tables, forms."],
  ["ghost", "Ghost", "The quietest: just the label until pointed at."],
  ["panel", "Panel", "Not an action: cards, windows, menus."],
];
const tones = ["accent", "info", "success", "warning", "danger", "neutral", "red", "orange", "green", "teal", "blue", "purple", "pink", "slate"];
const css = await codeBlock(`<!-- Any element can be a candy box: give it the class, then a tier and a tone. -->
<div class="chu-box" data-variant="soft" data-tone="teal" data-chu-r="5">…</div>

<style>
  .my-chip {
    --chu-r: 2; --chu-shape: var(--chu-shape-2); --chu-shape-inner: var(--chu-shape-2-inner);
    --chu-band-top: 1; --chu-band-bottom: 2; --chu-drop-size: 1;
  }
</style>`, "html", "HTML");
const H = (id: string, text: string) => ({ depth: 2, id, text });
---
<Docs styles={["foundations"]} scripts={["foundations"]} title="Shape" description="The candy box, Blip's one building block: its outline, bands, glints and drop; its stepped corners from 0 to 8 pixels; its tiers and tones." headings={[H("box", "The candy box"), H("corners", "Corners"), H("tiers", "Tiers"), H("tones", "Tones"), H("css", "In your own CSS")]}>
  <header class="docs-page-head">
    <h1 class="docs-page-title chu-display" data-scale="2">Shape</h1>
    <p class="docs-lede">Everything you can act on is one shape, the candy box, drawn in CSS at any size. Components set its corners, bands, tier and tone; none of them draws an outline, a drop, a focus ring or a dither of its own.</p>
  </header>

  <section class="docs-section" aria-labelledby="box">
    <h2 id="box">The candy box</h2>
    <p>Here one at a pixel of 10, so each of its parts is easy to see. The same box draws a 16-pixel button.</p>
    <div class="docs-anatomy">
      <div class="docs-anatomy-figure" role="img" aria-label="A large candy box with numbered parts: outline, light band, base, shade band, glints and drop.">
        <div class="chu-box docs-anatomy-box" data-tone="pink"></div>
        {["outline", "light", "base", "shade", "glints", "drop"].map((p, i) => <span class={`docs-pin docs-pin-${p}`} aria-hidden="true">{i + 1}</span>)}
      </div>
      <ol class="docs-anatomy-list" role="list">
        {parts.map(([name, text], i) => <li><span class="docs-pin-key" aria-hidden="true">{i + 1}</span><span><strong>{name}</strong> {text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="docs-section" aria-labelledby="corners">
    <h2 id="corners">Corners</h2>
    <p>Radius 0 to 8, in whole pixels, each corner a little staircase. Set it with <code class="docs-inline-code">data-chu-r</code> or <code class="docs-inline-code">.chu-r-N</code>; small things take small corners.</p>
    <div class="docs-radii" data-chu-pixel="4">
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((r) => (
        <figure><div class="chu-box docs-radius" data-tone="teal" data-chu-r={String(r)}></div><figcaption class="docs-label">{r}</figcaption></figure>
      ))}
    </div>
  </section>

  <section class="docs-section" aria-labelledby="tiers">
    <h2 id="tiers">Tiers</h2>
    <p>Loud to quiet. Candy for the main action, calmer tiers for dense screens, so a page is never a wall of candy.</p>
    <div class="docs-tiers">
      {tiers.map(([v, name, text]) => (
        <figure>
          <div class="docs-tier-sample"><span class="chu-box chu-button" data-variant={v === "candy" ? undefined : v}>{v === "panel" ? "Panel" : "Save game"}</span></div>
          <figcaption><strong>{name}</strong> <code class="docs-inline-code">{v === "candy" ? "(default)" : `data-variant="${v}"`}</code><span class="chu-muted chu-small">{text}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="docs-section" aria-labelledby="tones">
    <h2 id="tones">Tones</h2>
    <p>Meaning first: the accent, the four intents and a neutral. The raw candies are for games and decoration. Labels are ink on every one but slate, and every pairing passes AA.</p>
    <div class="docs-row docs-tones">
      {tones.map((t) => <span class="chu-box chu-button" data-size="sm" data-tone={t === "accent" ? undefined : t}>{t}</span>)}
    </div>
  </section>

  <section class="docs-section" aria-labelledby="css">
    <h2 id="css">In your own CSS</h2>
    <p>The box is a public building block in <code class="docs-inline-code">@jaatster/blip-core</code>. Its variables are the contract: a new component sets them, and it matches the rest.</p>
    <Fragment set:html={css} />
  </section>

  <Pager />
</Docs>
