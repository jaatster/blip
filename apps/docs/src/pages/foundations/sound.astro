---
/** Sound: a sound board for @blip/sound (off until pressed), the voice, and the package's own docs. */
import Docs from "../../layouts/Docs.astro";
import Pager from "../../components/Pager.astro";
import Icon from "../../components/Icon.astro";
import { docFor, docLink } from "../../lib/data";
import { renderMarkdown } from "../../lib/markdown";

const doc = docFor("sound", "sound")!;
const ref = await renderMarkdown(doc.source, { link: docLink("sound"), idPrefix: "sound-" });
// The board's buttons, from the package's own table of sounds (name, notes, use).
const table = doc.source.match(/## Sounds\n\n\|[^\n]*\n\|[^\n]*\n((?:\|[^\n]*\n)+)/)?.[1] ?? "";
const sounds = table.trim().split("\n").map((l) => l.split("|").map((c) => c.trim()).filter(Boolean)).map(([name, notes, use]) => ({ name: name!.replace(/`/g, ""), notes: notes!, use: use! }));
const TONES: Record<string, string> = { step: "red", look: "orange", jump: "green", coin: "yellow", open: "blue", back: "purple", bump: "pink", blip: "slate", success: "success", error: "danger", select: "neutral" };
// Yellow means focus: the coin's key stays cream like the rest of the neutral keys.
const tone = (n: string) => (TONES[n] === "yellow" ? "orange" : TONES[n] ?? "neutral");
const H = (id: string, text: string) => ({ depth: 2, id, text });
---
<Docs kits={["effects"]} styles={["foundations"]} scripts={["foundations"]} title="Sound" description="Blip's chip sounds: a sound board for @blip/sound, off until you turn it on, and the voice that types." headings={[H("board", "The board"), H("voice", "The voice"), H("sound-files", "The sound package"), ...ref.headings.filter((h) => h.depth === 2)]}>
  <header class="docs-page-head">
    <h1 class="docs-page-title blip-display" data-scale="2">Sound</h1>
    <p class="docs-lede">Eleven chip sounds, the TV's, synthesised in the browser from a few notes each: no audio files, about 1.6 KB. Sound is off until someone turns it on, and it never carries meaning on its own.</p>
  </header>

  <section class="docs-section" aria-labelledby="board">
    <h2 id="board">The board</h2>
    <p>Turn sound on, then press a key. Once it is on, the elements on this site use it too: menus open with a sound, toasts arrive with one, and typed text blips.</p>
    <div class="blip-box docs-board" data-variant="panel">
      <div class="docs-board-head">
        <button class="blip-box blip-button docs-sound-toggle" type="button" data-tone="slate" aria-pressed="false" data-docs-sound><Icon name="mute" class="docs-sound-off" /><Icon name="volume" class="docs-sound-on" /><span class="docs-sound-label">Sound off</span></button>
        <label class="docs-volume"><span class="blip-label">Volume</span>
          <span class="blip-slider-group"><input class="blip-slider docs-volume-input" type="range" min="0" max="10" value="7" aria-label="Volume" /></span>
        </label>
      </div>
      <ul class="docs-board-keys" role="list">
        {sounds.map((s) => (
          <li>
            <button class="blip-box blip-button docs-sound-key" type="button" data-tone={tone(s.name)} data-sound={s.name} aria-disabled="true" aria-describedby={`sound-${s.name}-use`}>{s.name}</button>
            <span class="docs-sound-notes blip-small" id={`sound-${s.name}-use`}>{s.use}<span class="blip-muted"> · {s.notes}</span></span>
          </li>
        ))}
      </ul>
      <p class="docs-note docs-board-hint" role="status">Sound is off. Turn it on with the first button.</p>
    </div>
  </section>

  <section class="docs-section" aria-labelledby="voice">
    <h2 id="voice">The voice</h2>
    <p>Characters talk in blips: each letter has its own small step, vowels sit a step up, and a mood shifts the whole voice. Type a line and play it.</p>
    <div class="docs-voice">
      <span class="blip-box blip-input"><input class="docs-voice-text" type="text" value="Ah, a traveller!" maxlength="60" aria-label="Line to speak" /></span>
      <blip-segmented class="blip-box blip-segmented docs-voice-mood" data-size="sm" aria-label="Mood" value="">
        <button class="blip-box" type="button" value="" aria-checked="true">Plain</button>
        <button class="blip-box" type="button" value="happy">Happy</button>
        <button class="blip-box" type="button" value="sleepy">Sleepy</button>
      </blip-segmented>
      <button class="blip-box blip-button docs-voice-play" type="button" data-tone="slate" aria-disabled="true"><Icon name="chat" />Speak</button>
    </div>
    <blip-typewriter class="blip-box docs-voice-out" data-variant="panel" blips>Ah, a traveller!</blip-typewriter>
  </section>

  <section class="docs-section docs-prose docs-reference" aria-labelledby="sound-files">
    <h2 id="sound-files">The sound package</h2>
    <p>From <code class="docs-inline-code">@blip/sound</code>'s own documentation.</p>
    <Fragment set:html={ref.html} />
  </section>

  <Pager />
</Docs>
