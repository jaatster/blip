---
/**
 * One page per component, from the package's own docs/<name>.md and examples/<name>.html: the example rendered live,
 * its source, any snippets (examples/<name>/NN-title.html, each live with its source), the markdown's sections, the element reference (from the Custom Elements Manifest when there is one)
 * and how to use it from React.
 */
import Docs from "../../layouts/Docs.astro";
import Example from "../../components/Example.astro";
import Table from "../../components/Table.astro";
import Pager from "../../components/Pager.astro";
import { APG, apgUrl, componentDocs, docLink, example, idsIn, snippet, type Doc } from "../../lib/data";
import { renderMarkdown, type Heading } from "../../lib/markdown";
import { elementReference } from "../../lib/cem";
import { code, esc, kitsFor, stripTags } from "../../lib/html";
import { reactSection } from "../../lib/react-section";
import { anatomyFigure } from "../../lib/anatomy";

export function getStaticPaths() {
  return componentDocs().map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
interface Props {
  doc: Doc;
}
const { doc } = Astro.props;
const { meta } = doc;
const r = await renderMarkdown(doc.source, { link: docLink(doc.pkg), anatomy: anatomyFigure(doc.slug) });
const ex = doc.example ? example(doc.example) : null;
const snippets = doc.snippets.map((rel) => snippet(doc, rel));
// Every snippet shares the page with the full example: an id used twice would wire a label or a button to the wrong one.
const owner = new Map(idsIn(ex?.html ?? "").map((id) => [id, doc.example!]));
doc.snippets.forEach((rel, i) => {
  for (const id of [snippets[i]!.id, ...idsIn(snippets[i]!.html)]) {
    if (owner.has(id)) throw new Error(`docs: ${rel} uses the id "${id}", which ${owner.get(id)} uses too. Ids must be unique on the page: prefix the snippet's.`);
    owner.set(id, rel);
  }
});
const eq = meta.equivalents;
const aka = eq.shadcn.length + eq.apg.length + eq.html.length > 0;
const kits = kitsFor([ex?.html ?? "", ...snippets.map((s) => s.html)].join("\n"), doc.pkg);
const elements = (meta.element ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const refs = elements.map((t) => elementReference(t)).filter((x) => !!x);

// React: the components @jaatster/blip-react has for this page today, their examples and props, read from its source.
const react = await reactSection(doc, ex?.html ?? null);
const preferred = doc.pkg === "components" || doc.pkg === "elements" ? "@jaatster/blip-react" : `@jaatster/blip-react/${doc.pkg}`;

const headings: Heading[] = [
  ...(ex ? [{ depth: 2, id: "example", text: "Example" }] : []),
  ...(snippets.length ? [{ depth: 2, id: "snippets", text: "Snippets" }, ...snippets.map((s) => ({ depth: 3, id: s.id, text: s.title }))] : []),
  ...r.headings,
  ...(refs.length ? [{ depth: 2, id: "element-reference", text: "Element reference" }] : []),
  ...(react || meta.react ? [{ depth: 2, id: "react", text: "React" }] : []),
  ...(react ? [{ depth: 3, id: "react-props", text: `${react.main.name} props` }] : []),
  ...(react?.parts.length ? [{ depth: 3, id: "react-parts", text: "Parts" }] : []),
  ...(react?.functions ?? []).map((f) => ({ depth: 3, id: `react-${f.name}`, text: `${f.name}()` })),
];
const statusTone = meta.status === "stable" ? "success" : meta.status === "beta" ? "info" : "warning";
// The command palette's own example already answers to Ctrl+K: the site's search steps aside to "/".
const searchShortcut = ex && /<pp-command[\s>]/.test(ex.html) ? "/" : undefined;
---
<Docs title={meta.name} description={stripTags(r.lede)} headings={headings} kits={kits} searchShortcut={searchShortcut} display>
  <header class="docs-page-head">
    <h1 class="docs-page-title pp-display" data-scale="2">{meta.name}</h1>
    <p class="docs-lede" set:html={r.lede} />
    <ul class="docs-meta" role="list" aria-label="About this component">
      <li><a class="docs-status" href="/versions/#status" aria-label={`Status: ${meta.status}. What it means`}><span class="pp-box pp-tag" data-size="sm" data-tone={statusTone}>{meta.status}</span></a></li>
      <li><span class="docs-meta-key">Package</span> <code class="docs-inline-code">{meta.package}</code></li>
      {meta.css && <li><span class="docs-meta-key">CSS</span> <code class="docs-inline-code">{meta.css}</code></li>}
      {elements.length > 0 && <li><span class="docs-meta-key">Element</span> {elements.map((t) => <code class="docs-inline-code">{`<${t}>`}</code>)}</li>}
      {react && <li><span class="docs-meta-key">React</span> <code class="docs-inline-code">{`<${react.main.name}>`}</code></li>}
    </ul>
    {aka && (
      <div class="docs-aka">
        <span class="docs-meta-key" id="also-known-as">Also known as</span>
        <ul class="docs-meta" role="list" aria-labelledby="also-known-as">
          {eq.shadcn.length > 0 && <li><span class="docs-meta-key">shadcn/ui</span> {eq.shadcn.join(", ")}</li>}
          {eq.apg.length > 0 && <li><span class="docs-meta-key">WAI-ARIA</span> {eq.apg.map((s, i) => <Fragment>{i > 0 && ", "}<a href={apgUrl(s)} rel="noopener">{APG[s]}<span class="pp-sr-only"> pattern</span></a></Fragment>)}</li>}
          {eq.html.length > 0 && <li><span class="docs-meta-key">HTML</span> {eq.html.map((h) => <code class="docs-inline-code">{h}</code>)}</li>}
        </ul>
      </div>
    )}
  </header>

  {ex && <Example id="example" html={ex.html} source={ex.source} note={ex.note} />}

  {snippets.length > 0 && (
    <section class="docs-section docs-snippets" aria-labelledby="snippets">
      <h2 id="snippets">Snippets</h2>
      <p>Small examples, one idea each, to copy as they are.</p>
      {snippets.map((s) => <Example id={s.id} html={s.html} source={s.source} note={s.note} title={s.title} level={3} switches={false} sourceOpen />)}
    </section>
  )}

  <div class="docs-prose docs-section" set:html={r.html} />

  {refs.length > 0 && (
    <section class="docs-section" aria-labelledby="element-reference">
      <h2 id="element-reference">Element reference</h2>
      <p>Generated from the package's Custom Elements Manifest, the same file the React types and Storybook read.</p>
      {refs.map((ref) => (
        <div class="docs-stack">
          <h3 class="docs-ref-title"><code class="docs-inline-code">{`<${ref.tag}>`}</code> <span class="pp-muted pp-small">{ref.module}</span></h3>
          {ref.summary && <p class="docs-note">{ref.summary}</p>}
          {ref.attributes.length > 0 && <Table label={`${ref.tag} attributes`} head={["Attribute", "Type", "Default", ""]} rows={ref.attributes.map((a) => [code(a.name), a.type ? code(a.type) : "", a.default ? code(a.default) : "", esc(a.description)])} />}
          {ref.properties.length > 0 && <Table label={`${ref.tag} properties`} head={["Property", "Type", ""]} rows={ref.properties.map((p) => [code(p.name) + (p.readonly ? ' <span class="pp-muted">read only</span>' : ""), p.type ? code(p.type) : "", esc(p.description)])} />}
          {ref.methods.length > 0 && <Table label={`${ref.tag} methods`} head={["Method", ""]} rows={ref.methods.map((m) => [code(m.signature), esc(m.description)])} />}
          {ref.events.length > 0 && <Table label={`${ref.tag} events`} head={["Event", "Detail", ""]} rows={ref.events.map((e) => [code(e.name), e.type ? code(e.type) : "", esc(e.description)])} />}
        </div>
      ))}
    </section>
  )}

  {react && (
    <section class="docs-section docs-react" aria-labelledby="react">
      <h2 id="react">React</h2>
      <p set:html={react.intro} />
      {react.examples.map((e, i) => (
        <Fragment>
          {i > 0 && <p class="docs-note">The example in its source:</p>}
          <Fragment set:html={e.html} />
          {e.checked && <p class="docs-note">From the React package's own examples, which are type-checked against React 18 and 19.</p>}
        </Fragment>
      ))}

      <h3 id="react-props"><code class="docs-inline-code">{`<${react.main.name}>`}</code> props</h3>
      {react.props.rows.length > 0
        ? <Table label={`${react.main.name} props`} head={["Prop", "Type", "Default", ""]} rows={react.props.rows} class="docs-props" />
        : <p>No props of its own.</p>}
      {react.props.rest && <p class="docs-note" set:html={react.props.rest} />}
      {react.props.notes.map((n) => <p class="docs-note" set:html={n} />)}

      {react.parts.length > 0 && (
        <Fragment>
          <h3 id="react-parts">Parts</h3>
          <p>The pieces that go inside it, each rendering one part of the markup above.</p>
          <Table label={`${react.main.name} parts`} head={["Component", "Renders", ""]} rows={react.partRows} />
          {react.partProps.length > 0 && (
            <details class="docs-react-more">
              <summary class="pp-box pp-button" data-variant="outline" data-size="sm"><span class="docs-when-closed">Show the parts' props</span><span class="docs-when-open">Hide the parts' props</span></summary>
              {react.partProps.map((p) => (
                <div class="docs-stack docs-react-part">
                  <h4 class="docs-react-h4"><code class="docs-inline-code">{`<${p.name}>`}</code></h4>
                  <Table label={`${p.name} props`} head={["Prop", "Type", "Default", ""]} rows={p.table.rows} class="docs-props" />
                  {p.table.rest && <p class="docs-note" set:html={p.table.rest} />}
                  {p.table.notes.map((n) => <p class="docs-note" set:html={n} />)}
                </div>
              ))}
            </details>
          )}
        </Fragment>
      )}
      {react.types.length > 0 && (
        <dl class="docs-react-types">
          {react.types.map(([name, values]) => <div><dt><code class="docs-inline-code">{name}</code></dt><dd set:html={values} /></div>)}
        </dl>
      )}

      {react.functions.map((f) => (
        <Fragment>
          <h3 id={`react-${f.name}`}><code class="docs-inline-code">{`${f.name}()`}</code></h3>
          <p set:html={f.description} />
          <Fragment set:html={f.signature} />
          {f.examples.map((e) => <Fragment set:html={e} />)}
        </Fragment>
      ))}
    </section>
  )}
  {!react && meta.react && (
    <section class="docs-section" aria-labelledby="react">
      <h2 id="react">React</h2>
      <p><code class="docs-inline-code">{`<${meta.react}>`}</code> is planned for <code class="docs-inline-code">{preferred}</code> but is not in the package yet. Until it is, write the markup above in JSX (<code class="docs-inline-code">class</code> becomes <code class="docs-inline-code">className</code>); everything else carries over.</p>
    </section>
  )}

  <Pager />
</Docs>
