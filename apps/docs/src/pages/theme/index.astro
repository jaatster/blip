---
/**
 * Palette maker: start from one of the palettes (Blip's own or a preset), turn four levers (the accent's hue and
 * strength, Night's tint and lightness) or start the accent from any colour, and see it in Day, Sunset and Night with
 * the checks the token build runs. Export it as CSS, or as a palette token file and resolver for blip-tokens.
 * The levers work the palette out with the same maths the presets were made with (palette.mjs), so a preset loaded
 * here comes out exactly as tokens.json has it: the page checks that when it is built.
 */
import Docs from "../../layouts/Docs.astro";
import Icon from "../../components/Icon.astro";
import Table from "../../components/Table.astro";
import { manifest, tokens, type Tokens } from "../../lib/data";
import { SCHEMES } from "../../lib/colour";
import { codeBlock } from "../../lib/markdown";
import { code, esc } from "../../lib/html";
import { RECIPES } from "../../../../../packages/tokens/scripts/palettes.mjs";
import { LEVERS, makePalette, toOklch } from "../../../../../packages/tokens/scripts/palette.mjs";
import { PUBLISHED } from "../../lib/install";

type Scheme = "day" | "sunset" | "night";
interface PaletteJson { name: string; description: string; credit?: string; shared: Record<string, string>; schemes: Record<Scheme, Record<string, string>> }
const t = tokens() as Tokens & { palette: string; palettes: Record<string, PaletteJson> };
const entries = manifest();

// Token paths and their names: palette.day.accent.base is --blip-palette-day-accent.
const paletteEntries = entries.filter((e) => e.palette && e.type === "color");
const nameOf = Object.fromEntries(paletteEntries.map((e) => [e.path, e.name]));
const hexes = Object.fromEntries(Object.entries(t.shared).filter((e): e is [string, string] => typeof e[1] === "string" && /^#[0-9A-F]{6}$/i.test(e[1])));
const kebab = (path: string) => path.split(".").filter((p, i, a) => !(p === "base" && i === a.length - 1)).join("-");
/** A palette value as a colour: an alias ({candy.blue.base}) is looked up. */
const hexOf = (v: string) => (v.startsWith("{") ? hexes[kebab(v.slice(1, -1))]! : v.toUpperCase());

// What a palette must read on, as the presets' generator has it (sceneOf in palettes.mjs), from the built tokens.
const surfaces = (s: Scheme) => [t.schemes[s].bg!, t.schemes[s].surface!, t.schemes[s]["surface-raised"]!];
const scene = {
  ink: t.schemes.day.ink!,
  warning: t.schemes.day.warning!,
  day: surfaces("day"),
  sunset: surfaces("sunset"),
  night: { text: ["info-text", "success-text", "warning-text", "danger-text", "link-visited"].map((k) => t.schemes.night[k]!) },
};

// The palettes, their recipes and what each keeps as it is. Each one is worked out again here and must match the
// tokens exactly, or the levers would start from somewhere else than the preset.
const ROLE = ["base", "light", "shade", "text"];
const flatKeep = (keep: Record<string, string[] | Record<string, string>> = {}) => {
  const out: Record<string, string> = {};
  for (const [group, value] of Object.entries(keep)) {
    if (Array.isArray(value)) value.forEach((v, i) => (out[`${group}.${ROLE[i]}`] = v));
    else for (const [k, v] of Object.entries(value)) out[`${group}.${k}`] = v;
  }
  return out;
};
const ownDays = (path: string) => /^palette\.(day|sunset)\./.test(path);
const palettes = RECIPES.map((r: { id: string; name: string; description: string; credit?: string; recipe: Record<string, unknown>; keep?: Record<string, string[] | Record<string, string>> }) => {
  const keep = flatKeep(r.keep);
  const full: Record<string, string> = { ...makePalette(r.recipe, scene), ...keep };
  const expected = (path: string) => (r.id === t.palette ? undefined : t.palettes[r.id]?.shared[nameOf[path]!]) ?? t.shared[nameOf[path]!];
  for (const [path, v] of Object.entries(full)) {
    if (hexOf(v) !== expected(path)) throw new Error(`docs: the palette maker works out ${r.id}'s ${path} as ${hexOf(v)}, but the tokens have ${expected(path)}`);
  }
  // A palette that keeps its own Day and Sunset (Candy's blue and pink, Grape's purple) can go on keeping them.
  const days = r.keep?.["palette.day.accent"] ? Object.fromEntries(Object.entries(full).filter(([p]) => ownDays(p))) : null;
  return {
    id: r.id, name: r.name, description: r.description, credit: r.credit, recipe: r.recipe, days,
    keep: Object.fromEntries(Object.entries(keep).filter(([p]) => !ownDays(p))),
    art: { bg: hexOf(full["palette.night.bg"]!), surface: hexOf(full["palette.night.surface.base"]!), accent: hexOf(full["palette.night.accent.base"]!), light: hexOf(full["palette.night.accent.light"]!), day: hexOf(full["palette.day.accent.base"]!), sunset: hexOf(full["palette.sunset.accent.base"]!), ink: hexOf(full["palette.night.ink"]!) },
  };
});
if (palettes[0]!.id !== t.palette) throw new Error(`docs: the palette maker expects ${t.palette} first in RECIPES`);

// Every palette colour at its default (Candy's), so the preview never shows a palette the site has set instead.
const defaults = Object.fromEntries(paletteEntries.map((e) => [e.path, t.shared[e.name] as string]));
const fixed = (s: Scheme) => ({
  bg: t.schemes[s].bg, surface: t.schemes[s].surface, raised: t.schemes[s]["surface-raised"], sunken: t.schemes[s]["surface-sunken"],
  dither: t.schemes[s]["disabled-dither"], ink: t.schemes[s].ink,
  info: t.schemes[s]["info-text"], success: t.schemes[s]["success-text"], danger: t.schemes[s]["danger-text"], visited: t.schemes[s]["link-visited"],
});
// What an accent must not look like: the intents (the same candies in every scheme) and the focus ring's yellow.
const intents = {
  danger: { name: "danger", base: t.schemes.day.danger, candy: "Gumball Red", why: "Red is danger in Blip: destructive actions, errors and invalid fields.", reads: "destructive" },
  warning: { name: "a warning", base: t.schemes.day.warning, candy: "Sherbet Orange", why: "Orange is warning in Blip (yellow is taken by focus).", reads: "a warning" },
  success: { name: "success", base: t.schemes.day.success, candy: "Sour Apple", why: "Green is success in Blip: done, saved, cleared.", reads: "done" },
};
const data = { scene, levers: LEVERS, hexes, names: nameOf, defaults, palettes, fixed: { day: fixed("day"), sunset: fixed("sunset"), night: fixed("night") }, titles: Object.fromEntries(SCHEMES.map((s) => [s.id, s.title])), intents, focus: t.schemes.day.focus, white: t.shared.white };
const LEVER_IDS = ["hue", "strength", "tint", "lightness"] as const;
// Where the levers stand for the default palette, and what its card says, in the page from the start (theme.js's
// levers() and about line), so nothing pops in once the script runs. The script then sets the site's palette.
const first = palettes[0]!;
const firstLevers = ((r: Record<string, unknown>) => {
  const lch = typeof r.accent === "string" ? toOklch(r.accent) : null;
  const page = typeof r.bg === "string" ? toOklch(r.bg) : null;
  return {
    hue: lch ? lch[2] : Number(r.hue ?? 0),
    strength: lch ? lch[1] / 0.15 : Number(r.strength ?? 1),
    tint: page ? page[1] : Number(r.tint ?? 0),
    lightness: page ? page[0] : Number(r.lightness ?? 0.235),
  };
})(first.recipe);
const leverShown: Record<(typeof LEVER_IDS)[number], (x: number) => string> = {
  hue: (x) => `${Math.round(x)}°`, strength: (x) => x.toFixed(2), tint: (x) => x.toFixed(3), lightness: (x) => x.toFixed(3),
};
const leverFill = (id: (typeof LEVER_IDS)[number]) => {
  const { min, max } = LEVERS[id];
  return `--blip-slider-value:${Math.min(1, Math.max(0, (firstLevers[id] - min) / (max - min)))}`;
};
const leverHelp: Record<(typeof LEVER_IDS)[number], string> = {
  hue: "Round the colour wheel, for Day, Sunset and Night.",
  strength: "1 is as colourful as a candy.",
  tint: "0 is a neutral charcoal; more takes on the hue.",
  lightness: "How light Night's page is. Its surfaces, wells and sky follow.",
};

// ------------------------------------------------------------------ by hand: the roles and the presets

const known = new Map(entries.map((m) => [m.name, m]));
const role = (name: string) => {
  if (!known.has(name)) throw new Error(`docs: the palette maker names --blip-${name}, which the tokens no longer have`);
  return code(known.get(name)!.cssVar);
};
// One name a line: the names are long, and a line of them would push the table off the page.
const each = (suffix: string, schemes: Scheme[] = ["day", "sunset", "night"]) => schemes.map((s) => role(`palette-${s}-${suffix}`)).join("<br>");
const all = (...names: string[]) => names.map(role).join("<br>");
const ROLES: [string, string][] = [
  [each("accent"), "The candy: the main button, the chosen tab, a checked box, the progress fill. Its label is ink, 4.5:1."],
  [each("accent-light"), "The light band, the fill of soft boxes and of chosen outline and ghost ones, and selected text, under ink."],
  [each("accent-shade"), "The shade band, and the top band of a chosen box. No text sits on it."],
  [each("accent-text"), "The accent as text: links, the caret, the chosen underline tab. 4.5:1 on that time of day's page and surfaces."],
  [each("warning"), "The warning, with -light, -shade and -text like the accent. Orange, unless the accent is orange too; then it turns amber."],
  [all("palette-night-bg", "palette-night-surface", "palette-night-surface-raised", "palette-night-surface-sunken"), "Night's page, its surfaces (cards, inputs), raised surfaces (menus, dialogs) and wells."],
  [all("palette-night-text", "palette-night-text-muted"), "Night's body and secondary text, 4.5:1 on all four; also the disabled dithers."],
  [all("palette-night-line", "palette-night-line-soft"), "Outlines of calm controls (3:1 on the page and surfaces), and dividers."],
  [role("palette-night-ink"), "Ink at Night: every outline and drop, labels on the candies, the scrim. Darker than the page, never black."],
  [code("--blip-world-night-*"), "The night sky and ground the world draws: 28 colours, the sky glowing faintly in the accent near the horizon."],
];
for (const s of ["day", "sunset", "night"]) for (const k of ["light", "shade", "text"]) role(`palette-${s}-warning-${k}`);
const roleRows = ROLES.map(([names, what]) => [names, esc(what)]);
const presetRows = palettes.filter((p) => p.id !== t.palette).map((p) => [code(p.id), esc(p.name), esc(p.description), esc(p.credit ?? "Blip")]);
const candyCss = await codeBlock(["/* After @jaatster/blip-tokens/tokens.css: Candy's own palette, as tokens.css sets it */", "@layer blip.tokens {", "  :root {", ...paletteEntries.filter((e) => e.path.startsWith("palette.")).map((e) => `    ${e.cssVar}: ${t.shared[e.name]};`), "    /* …and the 28 --blip-world-night-* colours */", "  }", "}"].join("\n"), "css", "my-palette.css");
const presetHtml = await codeBlock(`<link rel="stylesheet" href="@jaatster/blip-tokens/tokens.css">
<link rel="stylesheet" href="@jaatster/blip-tokens/palettes.css">

<html data-blip-palette="ember">`, "html", "HTML");
// @jaatster/blip-tokens' command (its README): builds the palette's tokens.css through Blip's checks.
const cli = await codeBlock(`npx @jaatster/blip-tokens my-palette.resolver.json                # writes my-palette.css beside it
npx @jaatster/blip-tokens my-palette.resolver.json --out src/tokens.css
npx @jaatster/blip-tokens my-palette.resolver.json --check        # checks only, writes nothing`, "sh", "Shell");
const H = (id: string, text: string) => ({ depth: 2, id, text });
const style = (vars: Record<string, string>) => Object.entries(vars).map(([k, v]) => `--a-${k}: ${v}`).join("; ");
---
<Docs title="Palette maker" description="Make a Blip palette: start from Candy or a preset (Ember, Dracula, Nord and more), turn the levers for the accent's hue and strength and Night's tint and lightness, check every pair in Day, Sunset and Night, and export it as CSS or DTCG tokens." wide kits={["effects"]} styles={["theme"]} scripts={["theme"]} headings={[H("tb-palettes-title", "Start from a palette"), H("tb-controls-title", "Your palette"), H("tb-preview-title", "Preview"), H("tb-export-title", "Export"), H("by-hand", "By hand")]}>
  <header class="docs-page-head tb-head">
    <h1 class="docs-page-title blip-display" data-scale="2">Palette maker</h1>
    <p class="docs-lede">A palette is the accent of each time of day and Night's dark page, ink and sky. Start from Blip's own or a preset, then turn the levers: everything else is worked out the way the presets were, every text colour nudged until it passes AA, and the result comes out as CSS or as token files for the resolver.</p>
  </header>

  <noscript><p class="blip-box blip-alert" data-tone="info"><span class="blip-alert-icon" aria-hidden="true"></span><span class="blip-alert-body">The maker needs JavaScript. For the presets and the palette's custom properties, see <a href="#by-hand">By hand</a> below.</span></p></noscript>

  <div class="tb docs-needs-js">
    <section class="tb-palettes" aria-labelledby="tb-palettes-title">
      <h2 class="tb-h2" id="tb-palettes-title">Start from a palette</h2>
      <div class="tb-cards" role="radiogroup" aria-labelledby="tb-palettes-title">
        {palettes.map((p, i) => (
          <label class="blip-box tb-card" data-variant="outline">
            <input type="radio" name="tb-palette" value={p.id} checked={i === 0} aria-describedby={`tb-about-${p.id}`} />
            <span class="tb-card-art" style={style(p.art)} aria-hidden="true"><span class="tb-card-panel"><span class="tb-card-pill"></span></span><span class="tb-card-days"><span></span><span></span></span></span>
            <span class="tb-card-name">{p.name}</span>
            <span class="blip-sr-only" id={`tb-about-${p.id}`}>{p.description}{p.credit && ` ${p.credit}.`}</span>
          </label>
        ))}
      </div>
      <p class="blip-small tb-about" aria-live="polite"><strong>{first.name}</strong>: {first.description}{first.credit && ` ${first.credit}.`}</p>
    </section>

    <section class="blip-box tb-controls" data-variant="panel" aria-labelledby="tb-controls-title">
      <h2 class="tb-h2" id="tb-controls-title">Your palette</h2>

      <fieldset class="tb-field">
        <legend class="blip-label">The accent, all day</legend>
        {LEVER_IDS.slice(0, 2).map((id) => (
          <div class="blip-field">
            <label class="blip-field-label" for={`tb-${id}`}>{LEVERS[id].label}</label>
            <div class="blip-slider-group">
              <input class="blip-slider tb-lever" id={`tb-${id}`} data-lever={id} type="range" min={LEVERS[id].min} max={LEVERS[id].max} step={LEVERS[id].step} value={firstLevers[id]} style={leverFill(id)} aria-describedby={`tb-${id}-help`} />
              <output class="blip-box blip-slider-value" data-variant="panel" for={`tb-${id}`} aria-hidden="true">{leverShown[id](firstLevers[id])}</output>
            </div>
            <p class="blip-field-help" id={`tb-${id}-help`}>{leverHelp[id]}</p>
          </div>
        ))}
        <label class="blip-label" for="tb-hex">Or start from any colour</label>
        <div class="tb-hex-row">
          <span class="blip-box blip-input tb-hex"><input id="tb-hex" type="text" inputmode="text" spellcheck="false" autocomplete="off" value={first.art.accent} aria-describedby="tb-hex-help tb-hex-error" /></span>
          <input class="tb-picker" type="color" value={first.art.accent.toLowerCase()} aria-label="Pick a colour" />
        </div>
        <p class="blip-field-error" id="tb-hex-error" aria-live="polite"></p>
        <p class="blip-field-help" id="tb-hex-help">Your colour as the candy, made lighter if an ink label would not read on it. The levers then turn it.</p>
        <label class="blip-check tb-days-row" data-layout="split" hidden><span class="tb-days-label">Keep Candy's Day and Sunset</span><span class="blip-box blip-switch"><input type="checkbox" role="switch" class="blip-box tb-days" aria-describedby="tb-days-help" /></span></label>
        <p class="blip-check-help tb-days-row" id="tb-days-help" hidden>On, the accent changes Night only. Off, it is the accent of all three.</p>
        <div class="tb-warnings" aria-live="polite"></div>
      </fieldset>

      <fieldset class="tb-field">
        <legend class="blip-label">Night's page</legend>
        {LEVER_IDS.slice(2).map((id) => (
          <div class="blip-field">
            <label class="blip-field-label" for={`tb-${id}`}>{LEVERS[id].label}</label>
            <div class="blip-slider-group">
              <input class="blip-slider tb-lever" id={`tb-${id}`} data-lever={id} type="range" min={LEVERS[id].min} max={LEVERS[id].max} step={LEVERS[id].step} value={firstLevers[id]} style={leverFill(id)} aria-describedby={`tb-${id}-help`} />
              <output class="blip-box blip-slider-value" data-variant="panel" for={`tb-${id}`} aria-hidden="true">{leverShown[id](firstLevers[id])}</output>
            </div>
            <p class="blip-field-help" id={`tb-${id}-help`}>{leverHelp[id]}</p>
          </div>
        ))}
      </fieldset>

      <div class="tb-field">
        <span class="blip-label">Worked out</span>
        <div class="tb-derived">
          <span class="blip-box tb-derived-box" aria-hidden="true"></span>
          <dl class="tb-derived-values">
            <div><dt>Light</dt><dd><span class="tb-dot" data-k="light"></span><code data-v="light"></code></dd></div>
            <div><dt>Candy</dt><dd><span class="tb-dot" data-k="base"></span><code data-v="base"></code></dd></div>
            <div><dt>Shade</dt><dd><span class="tb-dot" data-k="shade"></span><code data-v="shade"></code></dd></div>
            <div><dt>Text</dt><dd><span class="tb-dot" data-k="text"></span><code data-v="text"></code><span class="tb-from" data-v="text-scheme"></span></dd></div>
          </dl>
        </div>
        <dl class="tb-night-values" aria-label="Night's page">
          {[["bg", "Page"], ["surface", "Surface"], ["raised", "Raised"], ["sunken", "Well"], ["text", "Text"], ["muted", "Muted"], ["line", "Lines"], ["ink", "Ink"]].map(([k, label]) => <div><dt>{label}</dt><dd><span class="tb-dot" data-n={k}></span><code data-nv={k}></code></dd></div>)}
        </dl>
      </div>

      <div class="tb-field">
        <span class="blip-label" id="tb-scheme-label">Checks and preview for</span>
        <blip-segmented class="blip-box blip-segmented tb-scheme" aria-labelledby="tb-scheme-label" value="night" data-width="full">
          {SCHEMES.map((s) => <button class="blip-box" type="button" value={s.id} aria-checked={s.id === "night" ? "true" : "false"}><Icon name={s.id === "day" ? "sun" : s.id === "sunset" ? "sunset" : "moon"} />{s.title}</button>)}
        </blip-segmented>
        <ul class="tb-checks" role="list" aria-labelledby="tb-scheme-label"></ul>
        <p class="blip-small tb-summary" role="status"></p>
      </div>

      <div class="tb-field">
        <span class="blip-label" id="tb-pixel-label">Pixel</span>
        <blip-segmented class="blip-box blip-segmented tb-pixel" aria-labelledby="tb-pixel-label" value="2">
          <button class="blip-box" type="button" value="2" aria-checked="true">2 px</button>
          <button class="blip-box" type="button" value="3">3 px</button>
          <button class="blip-box" type="button" value="4">4 px</button>
        </blip-segmented>
      </div>

      <div class="docs-row">
        <button class="blip-box blip-button tb-try" type="button" data-variant="soft" data-size="sm" aria-pressed="false" aria-describedby="tb-try-help" hidden><Icon name="brush" />Try it on this page</button>
        <button class="blip-box blip-button tb-reset" type="button" data-variant="ghost" data-size="sm"><Icon name="undo" /><span class="tb-reset-label">Back to {first.name}</span></button>
      </div>
      <p class="blip-small blip-muted" id="tb-try-help">The palettes above are the site's own: picking one here sets it for every page, as the palette menu does. A palette you made with the levers can be tried on this page until you leave it.</p>
    </section>

    <section class="tb-preview-wrap" aria-labelledby="tb-preview-title">
      <h2 class="tb-h2" id="tb-preview-title">Preview</h2>
      <div class="tb-strip" aria-hidden="true">
        {SCHEMES.map((s) => <div class="tb-strip-cell" data-blip-scheme={s.id} data-strip={s.id}><span class="blip-box blip-button" data-size="sm">{s.title}</span><span class="blip-box blip-button" data-size="sm" data-variant="soft">Soft</span></div>)}
      </div>
      <div class="tb-night" data-blip-scheme="night" data-strip="night" aria-hidden="true" inert>
        <blip-world clouds="none" stars></blip-world>
        <div class="blip-box tb-night-card" data-variant="panel">
          <p class="tb-night-title">Saved to slot 2</p>
          <p class="blip-small">Body text, <span class="blip-muted">muted words</span> and <a href="#tb-preview-title">a link</a> on a surface.</p>
          <span class="blip-box blip-input"><input type="text" value="Player one" aria-label="Sample field" /></span>
          <div class="docs-row tb-night-tags">
            <span class="blip-box blip-tag" data-size="sm">Accent</span>
            <span class="blip-box blip-tag" data-size="sm" data-tone="info">Info</span>
            <span class="blip-box blip-tag" data-size="sm" data-tone="success">Done</span>
            <span class="blip-box blip-tag" data-size="sm" data-tone="warning">Warning</span>
            <span class="blip-box blip-tag" data-size="sm" data-tone="danger">Error</span>
          </div>
          <div class="docs-row">
            <button class="blip-box blip-button" type="button" data-size="sm">Continue</button>
            <button class="blip-box blip-button" type="button" data-size="sm" data-variant="outline">Back</button>
          </div>
        </div>
      </div>
      <div class="tb-preview-scroll docs-scroll">
        <div class="tb-preview" data-blip-scheme="night">
          <div class="blip-box tb-sample" data-variant="panel">
            <div class="tb-sample-head">
              <p class="blip-display blip-pop" data-scale="2" data-pop="Level 2">Level 2</p>
              <span class="blip-box blip-badge" data-size="sm">New</span>
            </div>
            <div class="blip-tabs" data-variant="soft" data-size="sm">
              <div class="blip-tabs-list" role="tablist" aria-label="Sample tabs">
                <button class="blip-box blip-tab" data-variant="soft" role="tab" aria-selected="true" type="button">Play</button>
                <button class="blip-box blip-tab" data-variant="soft" role="tab" aria-selected="false" type="button" tabindex="-1">Map</button>
                <button class="blip-box blip-tab" data-variant="soft" role="tab" aria-selected="false" type="button" tabindex="-1">Items</button>
              </div>
            </div>
            <p class="blip-body">Your palette's accent, in the parts that use it: candy and soft buttons, the chosen tab, a switch, a checkbox, the progress fill, POP letters and <a href="#tb-preview-title">a link like this one</a>.</p>
            <div class="docs-row">
              <button class="blip-box blip-button" type="button">Continue</button>
              <button class="blip-box blip-button" type="button" data-variant="soft">Options</button>
              <button class="blip-box blip-button" type="button" data-variant="outline" aria-pressed="true">Outline, on</button>
            </div>
            <div class="docs-row tb-focus-row">
              <button class="blip-box blip-button" type="button" data-blip-state="focus" tabindex="-1">Focused</button>
              <span class="blip-small blip-muted">The focus ring, beside your candy.</span>
            </div>
            <div class="tb-sample-row">
              <label class="blip-check"><span class="blip-box blip-checkbox"><input type="checkbox" checked /></span>Auto-save</label>
              <label class="blip-check"><span class="blip-box blip-switch"><input type="checkbox" role="switch" class="blip-box" checked /></span>Music</label>
              <span class="blip-box blip-tag">Rare</span>
            </div>
            <div>
              <div class="blip-progress-label"><label for="tb-progress">World 2</label><span>60%</span></div>
              <div class="blip-box blip-progress"><progress id="tb-progress" max="100" value="60">60%</progress></div>
            </div>
            <blip-segmented class="blip-box blip-segmented" data-size="sm" aria-label="Difficulty" value="normal">
              <button class="blip-box" type="button" value="easy">Easy</button>
              <button class="blip-box" type="button" value="normal" aria-checked="true">Normal</button>
              <button class="blip-box" type="button" value="hard">Hard</button>
            </blip-segmented>
          </div>
        </div>
      </div>
    </section>

    <section class="tb-export" aria-labelledby="tb-export-title">
      <h2 class="tb-h2" id="tb-export-title">Export</h2>
      <p class="docs-note">Two ways to use it. The CSS goes after Blip's <code class="docs-inline-code">tokens.css</code>, as it is: a <code class="docs-inline-code">:root</code> rule in the same layer, loaded later, wins. Or build a checked <code class="docs-inline-code">tokens.css</code> of your own: put the palette's token file and the resolver in your project's folder, beside <code class="docs-inline-code">node_modules</code>, and run <code class="docs-inline-code">blip-tokens</code>, which checks every pair as Blip's own palettes are checked, and writes a file to load instead of Blip's.</p>
      <Fragment set:html={cli} />
      {!PUBLISHED && <p class="docs-note"><code class="docs-inline-code">blip-tokens</code> comes with <code class="docs-inline-code">@jaatster/blip-tokens</code>, which is not on npm yet, so <code class="docs-inline-code">npx</code> finds it from the first release. Until then, run it from <a href="/start/">Blip built from its source</a>. The CSS works today.</p>}
      <div class="blip-box blip-alert tb-blocked" data-tone="danger" role="group" aria-labelledby="tb-blocked-title" hidden>
        <span class="blip-alert-icon" aria-hidden="true"></span>
        <div class="blip-alert-body">
          <p class="blip-alert-title" id="tb-blocked-title">Some pairs would not pass AA</p>
          <ul class="tb-blocked-list"></ul>
          <p>Turn a lever, or pick another colour. Or export it as it is, and check those pairs yourself:</p>
          <label class="blip-check"><span class="blip-box blip-checkbox" data-tone="danger"><input type="checkbox" class="tb-override" /></span>Export anyway</label>
        </div>
      </div>
      <p class="blip-small tb-downloaded" role="status"></p>
      <blip-tabs class="blip-tabs" data-variant="underline" data-size="sm">
        <div class="blip-tabs-list" role="tablist" aria-label="Export formats">
          <button class="blip-box blip-tab" data-variant="ghost" role="tab" aria-selected="true" type="button">CSS</button>
          <button class="blip-box blip-tab" data-variant="ghost" role="tab" aria-selected="false" type="button" tabindex="-1">Palette tokens</button>
          <button class="blip-box blip-tab" data-variant="ghost" role="tab" aria-selected="false" type="button" tabindex="-1">Resolver</button>
        </div>
        {[["css", "my-palette.css", "CSS"], ["tokens", "my-palette.tokens.json", "JSON"], ["resolver", "my-palette.resolver.json", "JSON"]].map(([id, file, lang], i) => (
          <div class="blip-tabs-panel" role="tabpanel" hidden={i > 0 ? true : undefined}>
            <figure class="blip-box docs-code tb-out">
              <figcaption class="docs-code-bar">
                <span class="docs-code-lang">{file}</span>
                <span class="docs-row tb-out-actions">
                  <button class="blip-box blip-button docs-copy" type="button" data-variant="ghost" data-size="sm" data-copy-from={`#tb-out-${id}`}>Copy</button>
                  <button class="blip-box blip-button tb-download" type="button" data-variant="soft" data-size="sm" data-file={file} data-from={`#tb-out-${id}`}><Icon name="download" />Download</button>
                </span>
              </figcaption>
              <pre class="tb-code" data-lang={lang} tabindex="0" aria-label={file}><code id={`tb-out-${id}`}></code></pre>
            </figure>
          </div>
        ))}
      </blip-tabs>
    </section>
  </div>

  <section class="docs-section tb-by-hand" aria-labelledby="by-hand">
    <h2 id="by-hand">By hand</h2>
    <p>The scheme roles read the palette: Night's <code class="docs-inline-code">--blip-bg</code> is <code class="docs-inline-code">var(--blip-palette-night-bg)</code>, every scheme's <code class="docs-inline-code">--blip-accent</code> its own <code class="docs-inline-code">--blip-palette-*-accent</code>. So a palette is these custom properties, set inside <code class="docs-inline-code">@layer blip.tokens</code> in a file loaded after <code class="docs-inline-code">tokens.css</code>. Keep them in the layer: outside it, they would beat the presets too.</p>
    <Table label="The palette's custom properties" head={["Custom properties", "What they paint"]} rows={roleRows} />
    <Fragment set:html={candyCss} />
    <p>Or use a preset: load <code class="docs-inline-code">@jaatster/blip-tokens/palettes.css</code> after the tokens and set <code class="docs-inline-code">data-blip-palette</code> on <code class="docs-inline-code">&lt;html&gt;</code>, or on an element that sets its own <code class="docs-inline-code">data-blip-scheme</code>: the roles are worked out where the scheme is set.</p>
    <Fragment set:html={presetHtml} />
    <Table label="The presets" head={["data-blip-palette", "Name", "What it is", "Credit"]} rows={presetRows} />
    <ul class="docs-help">
      <li>Nothing checks a CSS file. Put your colours into the maker, or write them as a palette token file and run <code class="docs-inline-code">blip-tokens</code> on it (see Export, above): it checks every pair in every scheme and stops on the first that fails.</li>
      <li>The info intent is the Day accent's blue in every scheme, and stays so. Success and danger are separate roles; an accent close to one of them makes every main button look like it. An accent close to the warning's orange moves the warning to amber.</li>
    </ul>
  </section>

  <script type="application/json" id="tb-data" set:html={JSON.stringify(data)} />
</Docs>
