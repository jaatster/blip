---
/**
 * The templates: three whole screens, each shown live here and full screen on its own page. The previews are whole
 * pages, so they load only once this page has, and only when they come near the window (tpl-index.js); without the
 * script, "Open full screen" shows them.
 */
import Docs from "../../layouts/Docs.astro";
import Icon from "../../components/Icon.astro";
import Pager from "../../components/Pager.astro";
import { TEMPLATES } from "../../lib/nav";
const parts: Record<string, string> = {
  dashboard: "Each view has its own URL, so Back and Forward work. App bar, sidebar, bottom bar, breadcrumbs, segmented controls, stats, progress bars and steps, tables, cards, lists, an alert, an empty state, a form, avatars, tags, a menu and toasts. The bar chart is the template's own CSS: there is no chart component yet.",
  landing: "Hero, features, pricing, call to action and footer from @jaatster/blip-blocks, on the world from @jaatster/blip-effects.",
  game: "The world, POP and drop-in letters, prompts, choices, options, the level map, the HUD and its course track, shouts, a talking dialogue, the pause menu, the tally and game over. Buttons stand in for play.",
};
---
<Docs title="Templates" description="Three whole screens built from Blip: a dashboard, a landing page and a game's screens." styles={["templates"]} scripts={["tpl-index"]} headings={TEMPLATES.map((t) => ({ depth: 2, id: t.slug, text: t.title }))}>
  <header class="docs-page-head">
    <h1 class="docs-page-title blip-display" data-scale="2">Templates</h1>
    <p class="docs-lede">Three whole screens made of Blip parts, with only their layout as page CSS (and, on the dashboard, a bar chart). Each runs live below at its real size; open one to use it full screen. Their markup is the place to start your own.</p>
  </header>
  <div class="tpl-index">
    {TEMPLATES.map((t) => (
      <section class="tpl-index-item" aria-labelledby={t.slug}>
        <div class="tpl-index-text">
          <h2 id={t.slug}><Icon name={t.icon!} /> {t.title}</h2>
          <p>{t.blurb}</p>
          <p class="blip-small blip-muted">{parts[t.slug]}{t.slug === "game" && <> <a href="/play/">Play Starfall</a>, these screens with a game in them.</>}</p>
          <a class="blip-box blip-button" href={t.url} data-size="sm"><Icon name="maximize" />Open full screen</a>
        </div>
        <div class="blip-box tpl-preview" data-variant="panel">
          <iframe data-src={t.url} title={`${t.title}, a live preview`} loading="lazy" tabindex="-1" inert></iframe>
        </div>
      </section>
    ))}
  </div>
  <Pager />
</Docs>
