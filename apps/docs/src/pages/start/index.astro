---
/** Get started: install, the CSS in its order, Tailwind, shadcn/ui, elements, React, frameworks, the theme switches, Auto, motion, diagnostics. */
import Docs from "../../layouts/Docs.astro";
import Table from "../../components/Table.astro";
import Pager from "../../components/Pager.astro";
import Icon from "../../components/Icon.astro";
import Install from "../../components/Install.astro";
import { assets, componentDocs, diagnostics, fontSection, pkgVersion, read, REPO } from "../../lib/data";
import { codeBlock } from "../../lib/markdown";
import { cdnStylesheets, cdnUrl } from "../../lib/install";
import { code, esc } from "../../lib/html";
import { booleanAttributes } from "../../lib/cem";
import { reactEntryFor } from "../../lib/react";
import { addCommand, REGISTRY_URL, SHADCN_NAMESPACE, setupImports, shadcnItems, THEME_MAP } from "../../lib/shadcn";

const a = assets();
const v = pkgVersion("components");
const H = (id: string, text: string) => ({ depth: 2, id, text });
const headings = [H("install", "Install"), H("css", "CSS, in order"), H("tailwind", "With Tailwind or your own CSS"), H("shadcn", "Use with shadcn/ui"), H("elements", "Web Components"), H("react", "React"), H("frameworks", "Frameworks"), H("theming", "Theming: two switches"), H("auto", "Auto: the clock"), H("motion", "Reduced motion"), H("languages", "Right to left and other languages"), H("diagnostics", "Diagnostics")];

// One set of packages for every package manager, and the CDN's files instead (lib/install.ts).
const installLines = [
  { packages: ["font", "tokens", "core", "components"] },
  { packages: ["elements", "icons"], comment: "behaviour and icons, when you need them" },
  { packages: ["game", "blocks", "effects", "sound"], comment: "kits" },
];
const cdn = `${cdnStylesheets()}

<script type="importmap">
{
  "imports": {
    "@jaatster/blip-core": "${cdnUrl("core", "dist/js/index.js")}",
    "@jaatster/blip-elements/": "${cdnUrl("elements", "dist/")}",
    "@jaatster/blip-effects/": "${cdnUrl("effects", "dist/")}",
    "@jaatster/blip-sound": "${cdnUrl("sound", "dist/index.js")}"
  }
}
</script>
<script type="module">
  import "@jaatster/blip-elements/tabs.js";
  import "@jaatster/blip-elements/menu.js";
</script>`;
const cssOrder = await codeBlock(`/* 1. The faces: Pixel Bop and Pixelify Sans */
@import "@jaatster/blip-font/font.css";
/* 2. The tokens: every colour, size and duration, three schemes, three pixel sizes */
@import "@jaatster/blip-tokens/tokens.css";
/* 3. The building blocks: the candy box, type, icons, motion, the page itself */
@import "@jaatster/blip-core/core.css";
/* 4. The components: all of them, or one file each (@jaatster/blip-components/button.css) */
@import "@jaatster/blip-components/components.css";
/* 5. Kits, as you need them */
@import "@jaatster/blip-game/game.css";
@import "@jaatster/blip-blocks/blocks.css";
@import "@jaatster/blip-effects/effects.css";`, "css", "CSS");
// The layer order as tokens.css declares it, and the order layers.css sets for a page with Tailwind: read from the
// packages, so this page says what they do.
const tokenLayers = read("packages/tokens/dist/css/tokens.css").match(/^@layer [^;{]+;/m)?.[0] ?? "";
const layers = await codeBlock(`${tokenLayers}

/* Your own CSS, outside the layers, always wins: */
.checkout .chu-button { --chu-tone: var(--chu-candy-green); }`, "css", "CSS");
const layersFile = read("packages/core/src/css/layers.css").replace(/\/\*[\s\S]*?\*\/\s*/g, "").trim();
const tailwind = await codeBlock(`/* app.css */
@import "@jaatster/blip-core/layers.css";   /* first */
@import "tailwindcss";
@import "@jaatster/blip-font/font.css";
@import "@jaatster/blip-tokens/tokens.css";
@import "@jaatster/blip-core/core.css";
@import "@jaatster/blip-components/components.css";`, "css", "CSS");
const layersCode = await codeBlock(layersFile, "css", "@jaatster/blip-core/layers.css");
const ownCss = await codeBlock(`@import "@jaatster/blip-core/layers.css";
@import "./reset.css" layer(base);         /* button { … }, a { … }: under Blip */
@import "@jaatster/blip-tokens/tokens.css";
/* … */`, "css", "CSS");
// shadcn/ui: the registry's items and what they write, from scripts/registry.mjs (lib/shadcn.ts).
const registryItems = shadcnItems();
const shadcnConfig = await codeBlock(`{
  "registries": {
    "${SHADCN_NAMESPACE}": "${REGISTRY_URL}"
  }
}`, "json", "components.json");
const shadcnAdd = await codeBlock(`${addCommand("theme", "button")}
${addCommand("dialog", "tabs")}   # more, as you need them`, "sh", "Terminal");
const shadcnCss = await codeBlock(`@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";
${setupImports().join(";\n")};`, "css", "CSS, after npx shadcn add");
const shadcnUse = await codeBlock(`<!doctype html>
<html lang="en" data-chu-scheme="day">   <!-- or sunset, night; data-chu-palette="grape" for a preset -->`, "html", "index.html");
const themeRows = Object.entries(THEME_MAP).map(([v, role]) => [code(`--${v}`), code(`--chu-${role}`)]);
const buttonProps = [
  [code('variant="default"'), `the default, ${code('variant="candy"')}`],
  [code('variant="secondary"'), code('variant="soft"')],
  [code('variant="outline"'), code('variant="outline"')],
  [code('variant="ghost"'), code('variant="ghost"')],
  [code('variant="destructive"'), `${code('tone="danger"')}, with any variant`],
  [code('variant="link"'), `${code("<Link>")}, or ${code("<ButtonLink>")} for a link that looks like a button`],
  [code('size="sm" | "default" | "lg"'), code('size="sm" | "md" | "lg"')],
  [code('size="icon"'), `${code("iconOnly")}, with an ${code("aria-label")}`],
];
const itemRows = registryItems.map((i) => [
  code(`${SHADCN_NAMESPACE}/${i.name}`),
  `${i.doc ? `<a href="${i.doc.url}">${esc(i.title)}</a>` : esc(i.title)}: ${esc(i.description)}`,
  i.files.length ? i.files.map((f) => code(f.split("/").pop())).join(" ") : esc(i.type === "registry:theme" ? "variables in your CSS file" : "packages, and imports in your CSS file"),
]);
const scripts = fontSection("Supported scripts", "Character set");
const elements = await codeBlock(`// One element at a time: each module defines its tag and imports only @jaatster/blip-core.
import "@jaatster/blip-elements/tabs";
import "@jaatster/blip-elements/menu";
import "@jaatster/blip-elements/toast";

// Or every element at once.
import "@jaatster/blip-elements";`, "js", "JavaScript");
const upgrade = await codeBlock(`<chu-tabs class="chu-tabs" data-variant="outline">
  <div class="chu-tabs-list" role="tablist" aria-label="Settings">
    <button class="chu-box chu-tab" data-variant="outline" role="tab" aria-selected="true">General</button>
    <button class="chu-box chu-tab" data-variant="outline" role="tab" aria-selected="false" tabindex="-1">Sound</button>
  </div>
  <div class="chu-tabs-panel" role="tabpanel">…</div>
  <div class="chu-tabs-panel" role="tabpanel" hidden>…</div>
</chu-tabs>`, "html", "HTML");
// One component from each entry, with the entry that exports it today (the build stops if one is gone).
const reactNames = [["Button", "Tabs"], ["Dialogue", "Hud"], ["Hero"], ["World"], ["Icon"]];
const reactImports = reactNames.map((names) => {
  const entries = names.map((n) => reactEntryFor(n));
  if (entries.some((e) => !e) || new Set(entries).size > 1) throw new Error(`docs: the start page imports ${names.join(", ")} from @jaatster/blip-react, which no longer exports them that way`);
  return `import { ${names.join(", ")} } from "${entries[0]}";`;
});
const react = await codeBlock(`import "@jaatster/blip-font/font.css";
import "@jaatster/blip-tokens/tokens.css";
import "@jaatster/blip-core/core.css";
import "@jaatster/blip-components/components.css";

${reactImports.join("\n")}`, "tsx", "TSX");
const vue = await codeBlock(`// vite.config.ts: let Vue leave chu-* tags to the browser
vue({ template: { compilerOptions: { isCustomElement: (tag) => tag.startsWith("chu-") } } })`, "ts", "Vue");
const defineFirst = await codeBlock(`// main.ts: define the elements, then mount
import "@jaatster/blip-elements/dialog";
import "@jaatster/blip-elements/tabs";
import { createApp } from "vue";
import App from "./App.vue";

createApp(App).mount("#app");`, "ts", "Vue");
const vueBoolean = await codeBlock(`<chu-dialog :open="open || undefined" @chu-close="open = false">…</chu-dialog>`, "html", "Vue");
const svelteBoolean = await codeBlock(`<chu-dialog open={open || undefined} onpp-close={() => (open = false)}>…</chu-dialog>`, "html", "Svelte");
const booleans = booleanAttributes();
// Which boolean attributes the elements read as off when they say "false" (their manifests say so).
const offNames = [...new Set(booleans.flatMap((b) => b.falseIsOff))].sort();
const allOff = booleans.length > 0 && booleans.every((b) => b.falseIsOff.length === b.names.length);
const list = (names: string[]) => names.map((n, i) => `${i ? (i === names.length - 1 ? " and " : ", ") : ""}<code class="docs-inline-code">${n}</code>`).join("");
const offNote = allOff
  ? ` Blip's elements read <code class="docs-inline-code">"false"</code> as off, but a native <code class="docs-inline-code">&lt;details open="false"&gt;</code> is open, and <code class="docs-inline-code">&lt;input disabled="false"&gt;</code> is disabled.`
  : offNames.length
    ? ` The elements' ${list(offNames)} read <code class="docs-inline-code">"false"</code> as off; their other booleans do not, nor does a native <code class="docs-inline-code">&lt;details open="false"&gt;</code>, which is open.`
    : " So a dialog defined after mounting, bound to <code class=\"docs-inline-code\">false</code>, opens on load.";
const angular = await codeBlock(`@Component({ selector: "app-settings", schemas: [CUSTOM_ELEMENTS_SCHEMA], templateUrl: "./settings.html" })
export class SettingsComponent {}`, "ts", "Angular");
const schemes = await codeBlock(`<html data-chu-scheme="night" data-chu-pixel="3">   <!-- the whole page -->
<section data-chu-scheme="day">…</section>           <!-- one part of it -->
<div class="game-screen" data-chu-pixel="4">…</div>  <!-- a bigger pixel for a TV or a game -->`, "html", "HTML");
const resolver = await codeBlock(`{
  "modifiers": {
    "scheme": { "contexts": { "day": […], "sunset": […], "night": […] }, "default": "day" },
    "pixel":  { "contexts": { "2": […], "3": […], "4": […] }, "default": "2" }
  }
}`, "json", "@jaatster/blip-tokens/resolver");
const auto = await codeBlock(`import { autoScheme, setScheme, schemeAt } from "@jaatster/blip-core";

const stop = autoScheme();              // follow the clock on <html>: Day, Sunset, Night
setScheme("night", panel);              // or pin one part of the page
schemeAt(new Date("2026-06-01T18:00")); // "sunset"
stop();                                 // stop following`, "js", "JavaScript");
const motion = await codeBlock(`import { reducedMotion, duration, run } from "@jaatster/blip-core";

if (!reducedMotion()) burstConfetti();
const ms = duration("glide", 160);       // 0 with reduced motion
await run([{ at: 0, do: up }, { at: 40, do: down }], { signal }); // runs at once with reduced motion`, "js", "JavaScript");
// A warning as the console shows it: an accessible-name code and its message, read from the source.
const named = diagnostics().get("CHU-A001") ?? [];
const sample = named.find((o) => o.file.endsWith("segmented.ts")) ?? named[0];
const diag = await codeBlock(`// On by default on localhost. Turn them on or off yourself:
globalThis.BLIP_DIAGNOSTICS = true;
${sample ? `
// Blip CHU-A001: ${sample.message}
//   https://jaatster.com/blip/diagnostics/#chu-a001` : ""}`, "js", "Console");

const docsByElement = new Map<string, { name: string; url: string }>();
for (const d of componentDocs()) for (const t of (d.meta.element ?? "").split(",").map((s) => s.trim()).filter(Boolean)) docsByElement.set(t, { name: d.meta.name, url: d.url });
const elementRows = Object.entries(a.defines)
  .sort(([x], [y]) => x.localeCompare(y))
  .map(([tag, mod]) => {
    const pkg = mod.split("/")[2];
    const spec = `@jaatster/blip-${pkg}/${mod.split("/").pop()!.replace(/\.js$/, "")}`;
    const d = docsByElement.get(tag) ?? (tag === "chu-icon" ? { name: "Icons", url: "/foundations/icons/" } : undefined);
    return [code(`<${tag}>`), code(spec), d ? `<a href="${d.url}">${esc(d.name)}</a>` : ""];
  });
---
<Docs title="Get started" description="Install Blip, load its CSS in order, add elements where you need behaviour, and switch schemes and pixel sizes." headings={headings}>
  <header class="docs-page-head">
    <h1 class="docs-page-title chu-display" data-scale="2">Get started</h1>
    <p class="docs-lede">Blip is plain CSS and dependency-free Web Components, with typed React wrappers on top. Four stylesheets give you every component; an element module adds behaviour only where a component needs it.</p>
  </header>

  <div class="chu-box chu-alert" data-tone="info" role="note">
    <span class="chu-alert-icon" aria-hidden="true"></span>
    <div class="chu-alert-body">
      <p class="chu-alert-title">Version {v} is not on npm yet</p>
      <p>Until it is published, build the packages from <a href={REPO}>the repository on GitHub</a> (<code class="docs-inline-code">pnpm install</code>, then <code class="docs-inline-code">pnpm build</code>) and link them. The commands below are how installing will work.</p>
    </div>
  </div>

  <section class="docs-section" aria-labelledby="install">
    <h2 id="install">Install</h2>
    <p>Start with the four core packages. Elements, icons and the kits are separate, so you install only what a screen uses.</p>
    <Install lines={installLines} cdn={cdn}>
      <p slot="cdn" class="docs-note">No build step: the files as published, and an import map for the modules. Map a package's folder with a trailing slash and import each module with its <code class="docs-inline-code">.js</code>.</p>
    </Install>
  </section>

  <section class="docs-section" aria-labelledby="css">
    <h2 id="css">CSS, in order</h2>
    <p>The order matters only once: the font, the tokens, the building blocks, the components, then any kits. Each file puts its rules in a cascade layer, so a later file never fights an earlier one, and your own CSS wins without <code class="docs-inline-code">!important</code>.</p>
    <Fragment set:html={cssOrder} />
    <p>The tokens file declares the layers. Anything you write outside them comes last:</p>
    <Fragment set:html={layers} />
    <p class="docs-note">Every component is also its own file (<code class="docs-inline-code">@jaatster/blip-components/tabs.css</code>), for an app that wants only a few. They all need the tokens and core first.</p>
  </section>

  <section class="docs-section" aria-labelledby="tailwind">
    <h2 id="tailwind">With Tailwind or your own CSS</h2>
    <p>Blip's rules are all in layers named <code class="docs-inline-code">chu</code>. Tailwind CSS v4 puts its own in layers too, and whichever loads first goes under the other: Blip's components then beat Tailwind's utility classes, or Tailwind's reset (preflight) strips Blip's buttons. <code class="docs-inline-code">@jaatster/blip-core/layers.css</code> sets one order for both. Import it first:</p>
    <Fragment set:html={tailwind} />
    <p>Tailwind's theme and reset go under all of Blip, and its components and utilities over it: <code class="docs-inline-code">className="mt-8"</code> moves a Blip button, and the reset leaves it alone. Once layers.css is first, the other imports can come in any order. It is two lines:</p>
    <Fragment set:html={layersCode} />
    <p>Your own CSS outside any layer beats every layer, Blip's included, which is right for your own classes. Rules for bare elements (a reset, <code class="docs-inline-code">button {"{ … }"}</code>, <code class="docs-inline-code">a {"{ … }"}</code>) would restyle Blip's components too: import them into the base layer, under Blip. That covers everything a component sets, and boxes also clear any corner rounding or shadow. A size a component leaves to its content, such as a <code class="docs-inline-code">min-height</code> on every button, still applies, so leave Blip's parts out of it with <code class="docs-inline-code">:not(.chu-box)</code>.</p>
    <Fragment set:html={ownCss} />
  </section>

  <section class="docs-section" aria-labelledby="shadcn">
    <h2 id="shadcn">Use with shadcn/ui</h2>
    <p>Blip is also a shadcn/ui registry. The <code class="docs-inline-code">shadcn</code> CLI can do two things with it: give an app's shadcn components Blip's colours with a theme, and copy Blip's own React components into the app, as it copies shadcn's. The copied files are yours to edit; Blip's CSS and its elements' behaviour stay in the npm packages, as Base UI and Radix do for shadcn. No Blip file uses Tailwind classes.</p>
    <p>Add the <code class="docs-inline-code">{SHADCN_NAMESPACE}</code> registry to the app's <code class="docs-inline-code">components.json</code> once, then add the theme and any components:</p>
    <Fragment set:html={shadcnConfig} />
    <Fragment set:html={shadcnAdd} />
    <p>Every item brings the setup: the four CSS packages from npm, imported into your Tailwind CSS file. The CLI adds imports after <code class="docs-inline-code">@import "tailwindcss"</code>, where layers.css (above) can no longer go first, so each import puts Blip inside Tailwind's <code class="docs-inline-code">components</code> layer: over the reset, under the utilities, the same order layers.css sets. <code class="docs-inline-code">className="mt-4"</code> still moves a Blip button.</p>
    <Fragment set:html={shadcnCss} />
    <p>Components land in <code class="docs-inline-code">components/blip/</code>, beside shadcn's <code class="docs-inline-code">components/ui/</code> rather than over it, so both can live in one app while you move screens across. Set the scheme on <code class="docs-inline-code">&lt;html&gt;</code> yourself: without it Blip follows the device's dark mode, and shadcn's <code class="docs-inline-code">dark:</code> classes, which follow the <code class="docs-inline-code">dark</code> class, would not.</p>
    <Fragment set:html={shadcnUse} />

    <h3 id="shadcn-theme">What the theme does, and what it doesn't</h3>
    <p><code class="docs-inline-code">{SHADCN_NAMESPACE}/theme</code> sets shadcn's variables to Blip's scheme roles by reference, so the colours follow <code class="docs-inline-code">data-chu-scheme</code> and <code class="docs-inline-code">data-chu-palette</code>, on the page or on any part of it. Borders and inputs take the ink line, the ring is the focus yellow, the radius is 0, every shadow is a one-pixel ink drop, the text is Pixelify Sans, and transitions step.</p>
    <p>That is as far as variables go. shadcn's own components stay shadcn's: square, flat and in Blip's colours, but without the stepped corners, the light and shade bands, the dithered disabled state or the snapping pop-in, and with their own translucent focus halo and fading, zooming animations. A style can also bypass the variables (Nova's card outline is the text colour at 10%). The full pixel look comes with Blip's components, whose props are Blip's:</p>
    <Table label="shadcn's Button props and Blip's" head={["shadcn's Button", "Blip's Button"]} rows={buttonProps} />
    <details class="docs-react-more">
      <summary class="chu-box chu-button" data-variant="outline" data-size="sm"><span class="docs-when-closed">Show the theme's variables</span><span class="docs-when-open">Hide the theme's variables</span></summary>
      <Table label="shadcn's variables and the Blip roles they take" head={["shadcn", "Blip"]} rows={themeRows} />
    </details>

    <h3 id="shadcn-items">Items</h3>
    <p>{registryItems.length} items, served from <code class="docs-inline-code">{REGISTRY_URL.replace("{name}", "registry")}</code> and written from the components' docs and React source when this site builds. Components go in <code class="docs-inline-code">components/blip/</code>, the helpers in <code class="docs-inline-code">lib/blip/</code>. Each component page shows its command.</p>
    <Table label="The registry's items" head={["Item", "", "Writes"]} rows={itemRows} />
  </section>

  <section class="docs-section" aria-labelledby="elements">
    <h2 id="elements">Web Components</h2>
    <p>Most components are CSS on native HTML: a <code class="docs-inline-code">&lt;button&gt;</code>, a <code class="docs-inline-code">&lt;dialog&gt;</code>, <code class="docs-inline-code">&lt;details&gt;</code>, the <code class="docs-inline-code">popover</code> attribute. Where a component needs behaviour (arrow keys in tabs, a menu's typeahead, toasts that time out), an element adds it to markup that already renders without JavaScript. Elements use light DOM, so your CSS reaches inside them.</p>
    <Fragment set:html={elements} />
    <Fragment set:html={upgrade} />
    <p>{elementRows.length} elements, each defined by its own module:</p>
    <Table label="Elements and their modules" head={["Element", "Module", "Docs"]} rows={elementRows} />
  </section>

  <section class="docs-section" aria-labelledby="react">
    <h2 id="react">React</h2>
    <p><code class="docs-inline-code">@jaatster/blip-react</code> wraps every component in a typed React component that renders the same markup and loads its element. Load the CSS once at the top of the app, as for plain HTML. Kits have their own entry points, so the core stays small.</p>
    <Fragment set:html={react} />
    <p>It works with React 18.3 and 19, and renders on the server; an element's module loads on the client when its component first mounts. Every component's page shows its React example, its parts and its props, read from the package's source.</p>
  </section>

  <section class="docs-section" aria-labelledby="frameworks">
    <h2 id="frameworks">Frameworks</h2>
    <p>Blip is HTML, CSS and custom elements, so any framework can use it: load the CSS, write the markup, import the elements a page uses. Two need to be told that <code class="docs-inline-code">chu-*</code> tags are custom elements.</p>
    <Fragment set:html={vue} />
    <Fragment set:html={angular} />
    <p class="docs-note">Svelte, Solid, Lit, Astro and plain HTML need no setting. This site is plain Astro pages with an import map: no client framework.</p>
    <h3 id="frameworks-booleans">Vue and Svelte: elements first, booleans present or absent</h3>
    <p>Import the elements before you mount the app. A defined element has properties, and Vue and Svelte set those, so <code class="docs-inline-code">:open="open"</code> opens and closes a dialog as you would expect.</p>
    <Fragment set:html={defineFirst} />
    <p>An element defined after the app mounts (a module loaded later, a split route) gets attributes instead, and both write <code class="docs-inline-code">false</code> as the text <code class="docs-inline-code">open="false"</code>. An HTML boolean is on whenever it is there, whatever it says.<Fragment set:html={offNote} /> Bind booleans as present or absent, and they mean the same everywhere: <code class="docs-inline-code">undefined</code> removes the attribute.</p>
    <Fragment set:html={vueBoolean} />
    <Fragment set:html={svelteBoolean} />
    <p>A combobox whose value your framework controls (React's <code class="docs-inline-code">value</code>, Vue's <code class="docs-inline-code">v-model</code>): give its input <code class="docs-inline-code">aria-autocomplete="list"</code>. The element then filters the list as the person types, without completing the text in a field the framework owns.</p>
    <p class="docs-note">The elements' boolean attributes: {booleans.map((b, i) => <Fragment>{i > 0 && "; "}{b.names.map((n, j) => <Fragment>{j > 0 && ", "}<code class="docs-inline-code">{n}</code></Fragment>)} on <code class="docs-inline-code">{`<${b.tag}>`}</code></Fragment>)}.</p>
  </section>

  <section class="docs-section" aria-labelledby="theming">
    <h2 id="theming">Theming: two switches</h2>
    <p>Themes are independent switches in the tokens' resolver, each a set of files: the <strong>scheme</strong> (Day, Sunset, Night) and the <strong>pixel</strong> (2, 3 or 4 CSS px). In CSS they are two attributes, on the page or on any part of it. Adding a theme means adding a token file, not changing code.</p>
    <Fragment set:html={schemes} />
    <Fragment set:html={resolver} />
    <p>With no scheme set, a page follows the device: Day, or Night in dark mode. To pick a preset palette, or make your own and export it as tokens, use the <a href="/theme/">palette maker</a>.</p>
  </section>

  <section class="docs-section" aria-labelledby="auto">
    <h2 id="auto">Auto: the clock</h2>
    <p>Auto follows the time of day as the TV did: Day from 6:00 to 17:00, Sunset until 19:00, Night after. When the time of day changes, every colour changes at once, because no mix of a light and a dark palette keeps all text readable; where the browser has view transitions, the new colours dither in over three frames, and the world's sky steps to the new one over a minute. This site starts on Auto; the display menu at the top changes it.</p>
    <Fragment set:html={auto} />
  </section>

  <section class="docs-section" aria-labelledby="motion">
    <h2 id="motion">Reduced motion</h2>
    <p>With <code class="docs-inline-code">prefers-reduced-motion: reduce</code>, every duration token is 0 ms, so transitions are instant, and every element, effect and timeline stops or arrives at once: no drifting clouds, no bobbing arrows, no dropping letters. Nothing you build on the tokens needs extra code; your own effects can ask.</p>
    <Fragment set:html={motion} />
  </section>

  <section class="docs-section" aria-labelledby="languages">
    <h2 id="languages">Right to left and other languages</h2>
    <p>Components mirror for text that runs right to left. Put <code class="docs-inline-code">dir="rtl"</code> on <code class="docs-inline-code">&lt;html&gt;</code> or on the part of the page that needs it, and set <code class="docs-inline-code">lang</code> there too (<code class="docs-inline-code">ar</code>, <code class="docs-inline-code">he</code>, <code class="docs-inline-code">fa</code>, <code class="docs-inline-code">ur</code>…). Blip's mirrored rules use <code class="docs-inline-code">:dir(rtl)</code>, and Vite 8's CSS minifier (lightningcss) rewrites that into a list of right-to-left languages (<code class="docs-inline-code">:lang(ar, he, …)</code>), so in its builds they follow <code class="docs-inline-code">lang</code>.</p>
    <p>The two faces draw Latin, Cyrillic and Greek, the last two in files of their own that load only when a page has those letters. Other scripts come from the system's fonts, sized to match: <a href={scripts.url}>{scripts.text}</a>, on the type page, says which languages each face covers.</p>
  </section>

  <section class="docs-section" aria-labelledby="diagnostics">
    <h2 id="diagnostics">Diagnostics</h2>
    <p>In development, Blip warns in the console with a code and a link: a dialog with no name, a menu with no list, an icon that does not exist. Production builds can turn them off by setting the flag to false. Every code is explained on the <a href="/diagnostics/">diagnostics page</a>.</p>
    <Fragment set:html={diag} />
  </section>

  <Pager />
</Docs>
