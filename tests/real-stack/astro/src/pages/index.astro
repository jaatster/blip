---
// A static page: the markup as the components' docs write it, the README's CSS, and the elements as modules. The
// scripts at the end stand in for content that arrives later (a fetch, a search, a server's answer).
import "../styles/app.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blip on Astro</title>
  </head>
  <body>
    <main>
      <h1 class="blip-display blip-pop" data-scale="3" data-pop="Level 2">Level 2</h1>

      <section id="docs-tabs" data-smoke="tabs">
        <!-- The start page's tabs, as it writes them. -->
        <blip-tabs class="blip-tabs" data-variant="outline">
          <div class="blip-tabs-list" role="tablist" aria-label="Settings">
            <button class="blip-box blip-tab" data-variant="outline" role="tab" aria-selected="true">General</button>
            <button class="blip-box blip-tab" data-variant="outline" role="tab" aria-selected="false" tabindex="-1">Sound</button>
          </div>
          <div class="blip-tabs-panel" role="tabpanel">Music, screen shake, big text.</div>
          <div class="blip-tabs-panel" role="tabpanel" hidden>Chip sounds are off until you turn them on.</div>
        </blip-tabs>
      </section>

      <section id="dialog">
        <!-- As the dialog's docs write it: invoker buttons open and close it. -->
        <button class="blip-box blip-button" type="button" id="open-dialog" commandfor="save" command="show-modal">Load game</button>
        <p id="dialog-state">closed</p>
        <blip-dialog>
          <dialog class="blip-box blip-dialog" id="save" aria-labelledby="save-title">
            <header class="blip-dialog-header"><h2 class="blip-dialog-title" id="save-title">Load game</h2></header>
            <div class="blip-dialog-body">Slot 2 will be replaced.</div>
            <footer class="blip-dialog-footer">
              <button class="blip-box blip-button" type="button" id="close-dialog" commandfor="save" command="close">Cancel</button>
            </footer>
          </dialog>
        </blip-dialog>
      </section>

      <section id="late-tabs">
        <blip-tabs class="blip-tabs">
          <div class="blip-tabs-list" role="tablist" aria-label="Worlds"></div>
        </blip-tabs>
        <button class="blip-box blip-button" type="button" id="add-tab">Add a tab</button>
      </section>

      <section id="combobox">
        <label class="blip-field-label" for="place">Start in</label>
        <blip-combobox class="blip-combobox">
          <span class="blip-box blip-input"><input id="place" list="places" /></span>
          <datalist id="places"></datalist>
        </blip-combobox>
        <p id="place-state"></p>
      </section>

      <form id="signup">
        <blip-field class="blip-field">
          <label class="blip-field-label" for="player">Player name</label>
          <span class="blip-box blip-input"><input id="player" name="player" /></span>
          <p class="blip-field-help">Shown on the leaderboard.</p>
        </blip-field>
        <button class="blip-box blip-button" id="submit">Join</button>
      </form>
    </main>

    <script>
      // Every element at once, as the start page offers.
      import "@jaatster/blip-elements";

      const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
      const make = (tag: string, props: object) => Object.assign(document.createElement(tag), props);

      // The dialog's state, from its events.
      $("blip-dialog").addEventListener("blip-open", () => ($("#dialog-state").textContent = "open"));
      $("blip-dialog").addEventListener("blip-close", () => ($("#dialog-state").textContent = "closed"));

      // Tabs that arrive after load, and one added later.
      const add = (name: string, selected: boolean) => {
        const tab = make("button", { className: "blip-box blip-tab", textContent: name, tabIndex: selected ? 0 : -1 });
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-selected", String(selected));
        const panel = make("div", { className: "blip-tabs-panel", textContent: `Panel ${name}`, hidden: !selected });
        panel.setAttribute("role", "tabpanel");
        $("#late-tabs [role=tablist]").append(tab);
        $("#late-tabs blip-tabs").append(panel);
      };
      setTimeout(() => ["Alpha", "Beta", "Gamma"].forEach((name, i) => add(name, i === 0)), 150);
      $("#add-tab").addEventListener("click", () => add("Delta", false));

      // A search that answers each query a moment later, into the datalist.
      const PLACES = ["Meadow", "Crystal caves", "Castle", "Canyon", "Desert", "Docks"];
      const place = $<HTMLInputElement>("#place");
      let search: ReturnType<typeof setTimeout> | undefined;
      place.addEventListener("input", () => {
        const q = place.value;
        $("#place-state").textContent = q;
        clearTimeout(search);
        search = setTimeout(() => $("#places").replaceChildren(...PLACES.filter((p) => q && p.toLowerCase().includes(q.toLowerCase())).map((value) => make("option", { value }))), 50);
      });

      // The server's answer to a submit: an error, gone again once the name changes.
      $("#signup").addEventListener("submit", (e) => {
        e.preventDefault();
        if (!$("#signup").querySelector(".blip-field-error")) $("#signup .blip-field-help").after(make("p", { className: "blip-field-error", textContent: "That name is taken." }));
      });
      $("#player").addEventListener("input", () => $("#signup").querySelector(".blip-field-error")?.remove());

      document.documentElement.setAttribute("data-mounted", "");
    </script>
  </body>
</html>
